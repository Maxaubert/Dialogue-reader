// 03 draw zones.
import { Palette, Space, Radius, Size, Type, Icons, Art, Kind, Kinds } from "../theme.slint";
import { ZoneData } from "../data.slint";
import { Icon, CIcon, Card, CardHead, SmallLabel } from "../components/base.slint";
import { ObHead } from "../components/chrome.slint";
import { Stage, ZoneRow, ZoneTools } from "../components/stage.slint";

export component KindHelp inherits VerticalLayout {
    for k in [
        { kind: Kind.dialogue, d: "Spoken lines" },
        { kind: Kind.speaker, d: "Who is talking" },
        { kind: Kind.pickups, d: "Item pop-ups" },
        { kind: Kind.prompts, d: "Button hints" },
        { kind: Kind.ignore, d: "Never read" },
    ]: HorizontalLayout {
        height: 28px;
        spacing: Space.s3;
        CIcon {
            source: Kinds.icon(k.kind);
        }

        Text {
            text: Kinds.name(k.kind);
            width: 72px;
            font-weight: Type.w-medium;
            color: Palette.text;
            vertical-alignment: center;
        }

        Text {
            text: k.d;
            color: Palette.text-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component DrawZonesPage inherits Rectangle {
    in-out property <[ZoneData]> zones;
    in-out property <int> selected: 1;
    in-out property <bool> draw: true;
    // zone editing (src/vm): the picture, the box being drawn, the kind picker
    in property <image> shot: Art.scene;
    in property <float> shot-w: 1600;
    in property <float> shot-h: 900;
    in property <bool> contain: false;
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <Kind> kind: Kind.dialogue;
    callback pointer(int, float, float, float);
    callback select(int);
    callback toggle(int, bool);
    callback rename(int, string);
    callback rename-done(bool);
    callback kind-picked(Kind);
    callback retake();
    VerticalLayout {
        x: (parent.width - Size.col) / 2;
        width: Size.col;
        padding-top: Space.s7;
        alignment: start;
        ObHead {
            title: "Mark where text shows up";
            lead: "Drag on the screenshot to draw a zone, then pick what kind of text it holds.";
        }
    }

    VerticalLayout {
        x: (parent.width - 1216px) / 2;
        y: Space.s7 + 37px + Space.s2 + 23px + Space.s5;
        width: 1216px;
        height: self.preferred-height;
        alignment: start;
        ZoneTools {
            draw <=> root.draw;
            kind: root.kind;
            kind-picked(k) => {
                root.kind-picked(k);
            }
            retake => {
                root.retake();
            }
        }

        Rectangle {
            height: Space.s4;
        }

        HorizontalLayout {
            spacing: Space.s5;
            height: 490px;
            Stage {
                width: 872px;
                source: root.shot;
                src-w: root.shot-w;
                src-h: root.shot-h;
                contain: root.contain;
                interactive: true;
                drafting: root.drafting;
                draft: root.draft;
                zones: root.zones;
                selected: root.selected;
                behind: Palette.bg;
                pointer(k, x, y, s) => {
                    root.pointer(k, x, y, s);
                }
            }

            Card {
                VerticalLayout {
                    padding: 1px;
                    CardHead {
                        title: "Zones";
                        count: root.zones.length;
                    }

                    // a long zone list scrolls
                    Flickable {
                        vertical-stretch: 1;
                        content-height: rows.preferred-height;
                        rows := VerticalLayout {
                            width: parent.width;
                            alignment: start;
                            for z[i] in root.zones: ZoneRow {
                                zone: z;
                                first: i == 0;
                                selected: i == root.selected;
                                editable: true;
                                clicked => {
                                    root.selected = i;
                                    root.select(i);
                                }
                                toggled(v) => {
                                    z.on = v;
                                    root.toggle(i, v);
                                }
                                renamed(t) => {
                                    root.rename(i, t);
                                }
                                rename-done(e) => {
                                    root.rename-done(e);
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.line;
                    }

                    VerticalLayout {
                        padding-left: Space.s5;
                        padding-right: Space.s5;
                        padding-top: Space.s3;
                        padding-bottom: Space.s4;
                        SmallLabel {
                            text: "What each kind does";
                        }

                        Rectangle {
                            height: Space.s1;
                        }

                        KindHelp { }
                    }
                }
            }
        }
    }
}
