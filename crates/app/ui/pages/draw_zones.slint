// Setup step 2, Mark where text shows up (d-black 01-setup, #step2). One toolbar row on black (Draw zone, the kinds,
// Delete zone; the screenshot time on the right while the game is not live), then the picture with the zones,
// 960 x 540.
// Dragging on empty picture always draws; "Draw zone" also draws over another zone (src/vm/zones.rs).
import { SetupPart, SetupStage } from "setup_part.slint";
import {
    Palette,
    Space,
    Radius,
    Size,
    Type,
    Motion,
    Icons,
    Art,
    Kind,
    Kinds,
} from "../theme.slint";
import { ZoneData } from "../data.slint";
import { CIcon, IconButton } from "../components/base.slint";
import { ObHead } from "../components/chrome.slint";
import { Stage, ShotNote } from "../components/stage.slint";

// "Draw zone" (.zt-draw): a button that stays on (surface-3 and a white border) while the tool is picked.
export component DrawToggle inherits Rectangle {
    in-out property <bool> on;
    height: Size.ctl;
    width: lay.preferred-width;
    border-radius: Radius.md;
    border-width: 1px;
    border-color: root.on ? Palette.on : touch.has-hover ? Palette.line-2 : Palette.line;
    background: root.on || touch.has-hover ? Palette.surface-3 : Palette.surface-2;
    transform-scale: touch.pressed ? Motion.press : 1;
    animate background, border-color, transform-scale {
        duration: Motion.fast;
        easing: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    accessible-role: button;
    accessible-label: "Draw zone";
    accessible-checked: root.on;
    accessible-action-default => {
        root.on = !root.on;
    }
    touch := TouchArea {
        clicked => {
            root.on = !root.on;
        }
    }

    lay := HorizontalLayout {
        padding-left: Space.s3 - 1px;
        padding-right: Space.s3 - 1px;
        spacing: Space.s2;
        CIcon {
            source: @image-url("../icons/draw.svg");
            color: root.on ? Palette.text : Palette.text-2;
        }

        Text {
            text: "Draw zone";
            font-weight: Type.w-strong;
            color: Palette.text;
            vertical-alignment: center;
        }
    }

    Tooltip {
        Rectangle {
            border-radius: Radius.md;
            border-width: 1px;
            border-color: Palette.line-2;
            background: Palette.surface-2;
            HorizontalLayout {
                padding-left: Space.s2;
                padding-right: Space.s2;
                padding-top: Space.s1;
                padding-bottom: Space.s1;
                Text {
                    text: "Draw a zone, also over another zone";
                    font-size: Type.fs-small;
                    color: Palette.text;
                    accessible-role: none;
                }
            }
        }
    }
}

// The kind of the selected zone, or of the next box (.seg.kinds): icon and name, the picked one in white.
export component KindSeg inherits Rectangle {
    in property <Kind> kind: Kind.dialogue;
    callback picked(Kind);
    height: Size.ctl;
    width: lay.preferred-width;
    border-radius: Radius.md;
    background: Palette.surface-2;
    border-width: 1px;
    border-color: Palette.line;
    lay := HorizontalLayout {
        padding: 3px;
        for k in [Kind.dialogue, Kind.speaker, Kind.pickups, Kind.prompts, Kind.ignore]: Rectangle {
            property <bool> on: k == root.kind;
            border-radius: Radius.sm;
            background: self.on ? Palette.on : transparent;
            animate background {
                duration: Motion.fast;
                easing: cubic-bezier(0.2, 0.7, 0.2, 1);
            }
            accessible-role: tab;
            accessible-label: Kinds.name(k);
            accessible-item-selected: self.on;
            accessible-action-default => {
                root.picked(k);
            }
            HorizontalLayout {
                padding-left: Space.s3;
                padding-right: Space.s3;
                spacing: Space.s2;
                CIcon {
                    source: Kinds.icon(k);
                    size: 14px;
                    color: on ? Palette.on-ink : kt.has-hover ? Palette.text : Palette.text-2;
                }

                Text {
                    text: Kinds.name(k);
                    font-weight: on ? Type.w-strong : Type.w-body;
                    color: on ? Palette.on-ink : kt.has-hover ? Palette.text : Palette.text-2;
                    vertical-alignment: center;
                }
            }

            kt := TouchArea {
                clicked => {
                    root.picked(k);
                }
            }

            Tooltip {
                Rectangle {
                    border-radius: Radius.md;
                    border-width: 1px;
                    border-color: Palette.line-2;
                    background: Palette.surface-2;
                    HorizontalLayout {
                        padding-left: Space.s2;
                        padding-right: Space.s2;
                        padding-top: Space.s1;
                        padding-bottom: Space.s1;
                        Text {
                            text: Kinds.tip(k);
                            font-size: Type.fs-small;
                            color: Palette.text;
                            accessible-role: none;
                        }
                    }
                }
            }
        }
    }
}

export component DrawZonesPage inherits Rectangle {
    // how much the step is drawn bigger (app.slint `setup-k`)
    in property <float> zoom: 0;
    in-out property <[ZoneData]> zones;
    // nothing is selected when the step opens (the trash is off until a zone is picked or drawn)
    in-out property <int> selected: -1;
    in-out property <bool> draw: false;
    // zone editing (src/vm): the picture, the box being drawn, the kind picker
    in property <image> shot: Art.scene;
    in property <float> shot-w: 1600;
    in property <float> shot-h: 900;
    in property <bool> contain: false;
    // the time of the screenshot ("21:30"; Rust leaves it empty while the game shows live)
    in property <string> shot-time: "21:30";
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <Kind> kind: Kind.dialogue;
    callback pointer(int, float, float, float);
    callback select(int);
    callback toggle(int, bool);
    callback rename(int, string);
    callback rename-done(bool);
    callback kind-picked(Kind);
    // the trash button: deletes the selected zone
    callback delete-zone();
    // the column top: title and lead, the toolbar
    property <length> head-h: head.preferred-height + Space.s5 + Size.ctl + Space.s3;
    stage := SetupStage {
        zoom: root.zoom;
        content-h: root.head-h + Size.col * 9 / 16;
        VerticalLayout {
            x: (stage.vw - Size.col) / 2;
            y: stage.top;
            width: Size.col;
            height: self.preferred-height;
            alignment: start;
            SetupPart {
                n: 0;
                head := ObHead {
                    title: "Mark where text shows up";
                    lead: "Drag to box text. Pick its kind.";
                }
            }

            Rectangle {
                height: Space.s5;
            }

            SetupPart {
                n: 1;
                HorizontalLayout {
                    height: Size.ctl;
                    spacing: Space.s2;
                    DrawToggle {
                        on <=> root.draw;
                    }

                    Rectangle {
                        width: 1px + 2 * Space.s1;
                        Rectangle {
                            width: 1px;
                            height: 20px;
                            background: Palette.line;
                        }
                    }

                    KindSeg {
                        kind: root.kind;
                        picked(k) => {
                            root.kind-picked(k);
                        }
                    }

                    IconButton {
                        icon: Icons.trash;
                        tip: "Delete zone";
                        enabled: root.selected >= 0 && root.selected < root.zones.length;
                        clicked => {
                            root.delete-zone();
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ShotNote {
                        contain: root.contain;
                        time: root.shot-time;
                        padding-right: Space.s2;
                    }
                }
            }
        }

        // 960 x 540, smaller when the window is short (16 px stay above the footer): then it keeps 16:9 and sits in
        // the middle of the column
        pic := SetupPart {
            n: 2;
            height: Math.max(160px, Math.min(Size.col * 9 / 16, stage.vh - stage.top - root.head-h - 16px));
            width: self.height * 16 / 9;
            x: (stage.vw - self.width) / 2;
            y: stage.top + root.head-h;
            Stage {
                // the live frames are made for the size the stage is drawn at
                zoom: stage.k;
                source: root.shot;
                src-w: root.shot-w;
                src-h: root.shot-h;
                contain: root.contain;
                interactive: true;
                drafting: root.drafting;
                draft: root.draft;
                zones: root.zones;
                selected: root.selected;
                radius: Radius.lg;
                behind: Palette.bg;
                pointer(k, x, y, s) => {
                    root.pointer(k, x, y, s);
                }
            }

            Rectangle {
                border-radius: Radius.lg;
                border-width: 1px;
                border-color: Palette.line;
            }

            // no zone yet: what to do, in the middle of the picture
            if root.zones.length == 0 && !root.drafting: Rectangle {
                width: hint.preferred-width + 2 * Space.s4;
                height: hint.preferred-height + 2 * Space.s2;
                border-radius: Radius.lg;
                background: Palette.float;
                border-width: 1px;
                border-color: Palette.float-line;
                hint := Text {
                    text: "Drag to box text.";
                    color: Palette.text;
                    accessible-role: none;
                }
            }
        }
    }
}
