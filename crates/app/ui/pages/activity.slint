// Activity list ("Show all" from Recent): every read and skipped line, filter All / Read / Skipped.
import { Palette, Space, Radius, Size, Type, Icons, Kind, Kinds } from "../theme.slint";
import { LineData } from "../data.slint";
import { Icon, CIcon, Button, BtnKind, Card, CardHead, Segmented } from "../components/base.slint";

component LogRow inherits Rectangle {
    in property <LineData> item;
    in property <bool> first;
    height: 44px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }
    HorizontalLayout {
        padding-left: Space.s5;
        padding-right: Space.s4;
        spacing: Space.s3;
        Text {
            width: 64px;
            text: root.item.time;
            font-family: Type.mono;
            font-size: Type.fs1;
            color: Palette.text-2;
            vertical-alignment: center;
        }

        HorizontalLayout {
            width: 96px;
            spacing: Space.s2;
            CIcon {
                source: Kinds.icon(root.item.kind);
            }

            Text {
                text: Kinds.name(root.item.kind);
                font-size: Type.fs1;
                font-weight: Type.w-medium;
                color: Palette.text-2;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            if root.item.who != "": Text {
                text: root.item.who;
                font-weight: Type.w-medium;
                color: Palette.text-2;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                text: root.item.line;
                color: root.item.skip != "" ? Palette.text-3 : Palette.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
        }

        // the reason ends where the replay icon of the other rows ends (button 32 px, icon 16 px)
        if root.item.skip != "": HorizontalLayout {
            padding-right: (Size.ctl - Size.icon) / 2;
            Text {
                text: root.item.skip;
                font-size: Type.fs1;
                color: Palette.text-3;
                vertical-alignment: center;
            }
        }
        if root.item.skip == "": VerticalLayout {
            alignment: center;
            Button {
                icon-only: true;
                icon: Icons.replay;
                kind: BtnKind.ghost;
                label: "Replay";
            }
        }
    }
}

export component ActivityTab inherits Rectangle {
    in property <[LineData]> log;
    in-out property <int> filter: 0;
    callback back();
    VerticalLayout {
        padding: Space.s5;
        Card {
            VerticalLayout {
                padding: 1px;
                alignment: start;
                CardHead {
                    title: "Activity";
                    pad-left: Space.s5;
                    pad-right: Space.s4;
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            items: ["All", "Read", "Skipped"];
                            selected: root.filter;
                            select(i) => {
                                root.filter = i;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Back to overview";
                            icon: Icons.arrow-left;
                            clicked => {
                                root.back();
                            }
                        }
                    }
                }

                for l[i] in root.log: VerticalLayout {
                    if root.filter == 0 || (root.filter == 1 && l.skip == "") || (root.filter == 2 && l.skip != ""): LogRow {
                        item: l;
                        first: i == 0;
                    }
                }
            }
        }
    }
}
