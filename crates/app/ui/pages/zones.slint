// Zones (d-black 11-zones): one toolbar on black (Draw zone, the kinds, Delete zone; the screenshot time while the
// game is not live, and Done on the right), then the picture with the zones as large as the page allows. Dragging on empty picture
// always draws; "Draw zone" also draws over another zone (src/vm/zones.rs). Each zone has a tag with its kind
// name above it, under it when there is no room above, and inside it when there is no room under it either.
import {
    Palette,
    Space,
    Radius,
    Size,
    Type,
    Motion,
    Icons,
    Art,
    Kind,
    Kinds,
} from "../theme.slint";
import { ZoneData } from "../data.slint";
import { Button, BtnKind, Icon, IconButton } from "../components/base.slint";
import { Stage, ShotNote } from "../components/stage.slint";
import { DrawToggle, KindSeg } from "draw_zones.slint";
import { OverviewRect } from "overview.slint";

export component ZonesTab inherits Rectangle {
    in-out property <[ZoneData]> zones;
    in-out property <int> selected: 1;
    in-out property <bool> draw: false;
    callback delete-zone(int);
    // zone editing (src/vm): the picture, the box being drawn, the kind picker
    in property <image> shot: Art.scene;
    in property <float> shot-w: 1600;
    in property <float> shot-h: 900;
    in property <bool> contain: false;
    // the time of the saved screenshot ("21:30"; Rust leaves it empty while the game shows live)
    in property <string> shot-time: "21:30";
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <Kind> kind: Kind.dialogue;
    callback pointer(int, float, float, float);
    callback kind-picked(Kind);
    // "Done": back to the Overview (app.slint)
    callback done();
    // the stage grow from the Overview (README motion table, 11-zones 4): 0 at the Overview stage, 1 here. The
    // toolbar and the tags fade in 120 ms into the 300 ms grow, over the last 180 ms.
    in property <float> grow: 1;
    property <float> tools: Math.clamp((root.grow - 0.4) / 0.6, 0, 1);
    // switch game (app.slint), as on the Overview: the zones and the screenshot time fade out and in (`text-o`);
    // the new picture fades in (`pic-t`, 0 to 1) over the old one (`old-shot`), so the picture never dips to black.
    // The toolbar stays.
    in property <float> text-o: 1;
    in property <float> pic-t: 1;
    in property <image> old-shot;
    in property <float> old-w: 1600;
    in property <float> old-h: 900;

    // the toolbar (.zn-tb) and the picture under it, 32 px from the sides
    property <length> pad: 32px;
    property <length> top: 64px;
    property <length> sw: max(160px, min(root.width - 2 * root.pad, (root.height - root.top - Space.s4) * 16 / 9));
    property <length> sh: root.sw * 9 / 16;

    // the toolbar has the Overview toolbar's margins (Done is where "Edit zones" is); the picture keeps 32 px
    Rectangle {
        x: Size.page-x;
        y: 12px;
        width: root.width - 2 * Size.page-x;
        height: Size.ctl;
        opacity: root.tools;
        HorizontalLayout {
            spacing: Space.s2;
            DrawToggle {
                on <=> root.draw;
            }

            Rectangle {
                width: 1px + 2 * Space.s1;
                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Palette.line;
                }
            }

            KindSeg {
                kind: root.kind;
                picked(k) => {
                    root.kind-picked(k);
                }
            }

            IconButton {
                icon: Icons.trash;
                tip: "Delete zone";
                enabled: root.selected >= 0 && root.selected < root.zones.length;
                clicked => {
                    root.delete-zone(root.selected);
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            // "Live", or the screenshot's time (src/vm/live.rs)
        ShotNote {
                opacity: root.text-o;
                contain: root.contain;
                time: root.shot-time;
                padding-right: Space.s2;
            }

            // at the same place and of the same kind as "Edit zones" on the Overview: the two swap in place
            Button {
                kind: BtnKind.primary;
                text: "Done";
                icon: Icons.check;
                clicked => {
                    root.done();
                }
            }
        }
    }

    // the Overview stage rectangle, where the grow starts
    property <length> ox: OverviewRect.x(root.width, root.height);
    property <length> oy: OverviewRect.y(root.width, root.height);
    property <length> ow: OverviewRect.stage-w(root.width, root.height);
    pic := Rectangle {
        x: root.ox + ((root.width - root.sw) / 2 - root.ox) * root.grow;
        y: root.oy + (root.top - root.oy) * root.grow;
        width: root.ow + (root.sw - root.ow) * root.grow;
        height: self.width * 9 / 16;
        // switch game: the old picture stays under the new one while it fades in
        if root.pic-t < 1: Stage {
            follow-live: false;
            settled: false;
            source: root.old-shot;
            src-w: root.old-w;
            src-h: root.old-h;
            contain: root.contain;
            labels: false;
            radius: Radius.lg;
            behind: Palette.bg;
        }
        st := Stage {
            opacity: root.pic-t;
            // the old game's zones go out with its texts; the new ones come in with the new picture
            marks-o: root.pic-t < 1 ? 1 : root.text-o;
            settled: root.grow >= 1;
            tags-o: root.tools;
            source: root.shot;
            src-w: root.shot-w;
            src-h: root.shot-h;
            contain: root.contain;
            interactive: true;
            drafting: root.drafting;
            draft: root.draft;
            zones: root.zones;
            selected: root.selected;
            radius: Radius.lg;
            behind: Palette.bg;
            pointer(k, x, y, s) => {
                root.pointer(k, x, y, s);
            }
        }

        Rectangle {
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Palette.line;
        }

        // no zone yet: what to do, in the middle of the picture
        if root.zones.length == 0 && !root.drafting: Rectangle {
            opacity: root.tools * root.text-o;
            width: hint.preferred-width + 2 * Space.s4;
            height: hint.preferred-height + 2 * Space.s2;
            border-radius: Radius.lg;
            background: Palette.float;
            border-width: 1px;
            border-color: Palette.float-line;
            hint := Text {
                text: "Drag to box text.";
                color: Palette.text;
                accessible-role: none;
            }
        }
    }
}
