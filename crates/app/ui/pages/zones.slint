// Zones (d-black 11-zones): one toolbar on black (Draw zone, the kinds, Delete zone; the live note, Retake screenshot
// and Done on the right), then the picture with the zones as large as the page allows. Dragging on empty picture
// always draws; "Draw zone" also draws over another zone (src/vm/zones.rs). Each zone has a tag with its kind
// name above it, under it when there is no room above, and inside it when there is no room under it either.
import { Palette, Space, Radius, Size, Type, Motion, Icons, Art, Kind, Kinds } from "../theme.slint";
import { ZoneData } from "../data.slint";
import { Button, BtnKind, Icon, IconButton } from "../components/base.slint";
import { Stage, ShotNote } from "../components/stage.slint";
import { DrawToggle, KindSeg } from "draw_zones.slint";

export component ZonesTab inherits Rectangle {
    in-out property <[ZoneData]> zones;
    in-out property <int> selected: 1;
    in-out property <bool> draw: false;
    callback delete-zone(int);
    // zone editing (src/vm): the picture, the box being drawn, the kind picker
    in property <image> shot: Art.scene;
    in property <float> shot-w: 1600;
    in property <float> shot-h: 900;
    in property <bool> contain: false;
    // the time of the saved screenshot ("21:30"; Rust leaves it empty while the game shows live)
    in property <string> shot-time: "21:30";
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <Kind> kind: Kind.dialogue;
    callback pointer(int, float, float, float);
    callback kind-picked(Kind);
    callback retake();
    // "Done": back to the Overview (app.slint)
    callback done();

    // the toolbar (.zn-tb) and the picture under it, 32 px from the sides
    property <length> pad: 32px;
    property <length> top: 64px;
    property <length> sw: max(160px, min(root.width - 2 * root.pad, (root.height - root.top - Space.s4) * 16 / 9));
    property <length> sh: root.sw * 9 / 16;

    HorizontalLayout {
        x: root.pad;
        y: 12px;
        width: root.width - 2 * root.pad;
        height: Size.ctl;
        spacing: Space.s2;
        DrawToggle {
            on <=> root.draw;
        }

        Rectangle {
            width: 1px + 2 * Space.s1;
            Rectangle {
                width: 1px;
                height: 20px;
                background: Palette.line;
            }
        }

        KindSeg {
            kind: root.kind;
            picked(k) => {
                root.kind-picked(k);
            }
        }

        IconButton {
            icon: Icons.trash;
            tip: "Delete zone";
            enabled: root.selected >= 0 && root.selected < root.zones.length;
            clicked => {
                root.delete-zone(root.selected);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // "Live", or the screenshot's time (src/vm/live.rs)
        ShotNote {
            contain: root.contain;
            time: root.shot-time;
        }

        IconButton {
            icon: Icons.camera;
            tip: "Retake screenshot";
            clicked => {
                root.retake();
            }
        }

        Button {
            kind: BtnKind.primary;
            text: "Done";
            clicked => {
                root.done();
            }
        }
    }

    pic := Rectangle {
        x: (root.width - root.sw) / 2;
        y: root.top;
        width: root.sw;
        height: root.sh;
        st := Stage {
            source: root.shot;
            src-w: root.shot-w;
            src-h: root.shot-h;
            contain: root.contain;
            interactive: true;
            drafting: root.drafting;
            draft: root.draft;
            zones: root.zones;
            selected: root.selected;
            radius: Radius.lg;
            behind: Palette.bg;
            pointer(k, x, y, s) => {
                root.pointer(k, x, y, s);
            }
        }

        Rectangle {
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Palette.line;
        }

        // no zone yet: what to do, in the middle of the picture
        if root.zones.length == 0 && !root.drafting: Rectangle {
            width: hint.preferred-width + 2 * Space.s4;
            height: hint.preferred-height + 2 * Space.s2;
            border-radius: Radius.lg;
            background: Palette.float;
            border-width: 1px;
            border-color: Palette.float-line;
            hint := Text {
                text: "Drag to box text.";
                color: Palette.text;
                accessible-role: none;
            }
        }
    }
}
