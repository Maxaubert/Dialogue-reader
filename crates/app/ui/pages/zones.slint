// 11 zone editor tab.
import { Palette, Space, Radius, Size, Type, Icons, Art, Kind } from "../theme.slint";
import { ZoneData } from "../data.slint";
import { Icon, CIcon, Button, BtnKind, CardHead, Dot } from "../components/base.slint";
import { Stage, ZoneRow, ZoneTools, LiveView } from "../components/stage.slint";

export component ZonesTab inherits Rectangle {
    in-out property <[ZoneData]> zones;
    in-out property <int> selected: 1;
    in-out property <bool> draw: false;
    in property <string> shot-info: "Screenshot 21:30 · 3840 × 2160 · Fit to window";
    // window size, so the stage size does not depend on its own layout
    in property <length> win-w: 1440px;
    in property <length> win-h: 900px;
    property <length> sw: min(root.win-w - 360px - 2 * Size.page-x, (root.win-h - Size.bar - 64px - 44px - 2 * Size.page-x) * 16 / 9);
    callback add-zone();
    callback delete-zone(int);
    // zone editing (src/vm): the picture, the box being drawn, the kind picker
    in property <image> shot: Art.scene;
    in property <float> shot-w: 1600;
    in property <float> shot-h: 900;
    in property <bool> contain: false;
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <Kind> kind: Kind.dialogue;
    callback pointer(int, float, float, float);
    callback select(int);
    callback toggle(int, bool);
    callback rename(int, string);
    callback rename-done(bool);
    callback kind-picked(Kind);
    callback retake();
    // "Done": back to the Overview (app.slint)
    callback done();

    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            background: Palette.canvas;
            VerticalLayout {
                Rectangle {
                    height: 64px;
                    HorizontalLayout {
                        padding-left: Size.page-x;
                        padding-right: Size.page-x;
                        VerticalLayout {
                            alignment: center;
                            ZoneTools {
                                draw <=> root.draw;
                                kind: root.kind;
                                kind-picked(k) => {
                                    root.kind-picked(k);
                                }
                                retake => {
                                    root.retake();
                                }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Palette.line;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    Stage {
                        width: root.sw;
                        height: root.sw * 9 / 16;
                        source: root.shot;
                        src-w: root.shot-w;
                        src-h: root.shot-h;
                        contain: root.contain;
                        interactive: true;
                        drafting: root.drafting;
                        draft: root.draft;
                        zones: root.zones;
                        selected: root.selected;
                        behind: Palette.canvas;
                        pointer(k, x, y, s) => {
                            root.pointer(k, x, y, s);
                        }
                    }
                }

                Rectangle {
                    height: 44px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Palette.line;
                    }

                    HorizontalLayout {
                        padding-left: Size.page-x;
                        padding-right: Size.page-x;
                        Text {
                            text: "Drag on the screenshot to draw a zone. Drag a corner to resize.";
                            font-size: Type.fs1;
                            color: Palette.text-3;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        // the live view note is part of this line (src/vm/live.rs `push_shot_info`): a green dot
                        // while it is live, never a chip on the game picture
                        if root.contain && LiveView.note-live: VerticalLayout {
                            alignment: center;
                            padding-right: 6px;
                            Dot {
                                size: 6px;
                                tint: Palette.ok;
                            }
                        }
                        Text {
                            text: root.shot-info;
                            font-size: Type.fs1;
                            color: Palette.text-3;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 360px;
            background: Palette.surface;
            Rectangle {
                x: 0;
                width: 1px;
                background: Palette.line;
            }

            VerticalLayout {
                padding-left: 1px;
                CardHead {
                    height: 64px;
                    title: "Zones";
                    count: root.zones.length;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Add zone";
                            icon: Icons.plus;
                            clicked => {
                                root.add-zone();
                            }
                        }
                    }
                }

                // a long zone list scrolls
                Flickable {
                    vertical-stretch: 1;
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        for z[i] in root.zones: ZoneRow {
                            zone: z;
                            first: i == 0;
                            selected: i == root.selected;
                            editable: true;
                            clicked => {
                                root.selected = i;
                                root.select(i);
                            }
                            toggled(v) => {
                                z.on = v;
                                root.toggle(i, v);
                            }
                            renamed(t) => {
                                root.rename(i, t);
                            }
                            rename-done(e) => {
                                root.rename-done(e);
                            }
                        }
                    }
                }

                Rectangle {
                    height: 64px;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Palette.line;
                    }

                    HorizontalLayout {
                        padding-left: Space.s5;
                        padding-right: Space.s5;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Delete zone";
                                icon: Icons.trash;
                                kind: BtnKind.danger;
                                pad-x: -1px;
                                clicked => {
                                    root.delete-zone(root.selected);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
