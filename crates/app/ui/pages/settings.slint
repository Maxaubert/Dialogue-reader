// 12 settings. The Shortcuts section of the mockup becomes "Keys": the same two 04-read-key-d cards as onboarding
// (read key and quick menu key). Max picked "D everywhere", 2026-11-22.
// M5: the Startup and In-game overlay rows are saved (src/vm/prefs.rs), Updates shows the real version, and a
// "Games" section (no mockup; listed in docs/app-plan.md, "Text changes for Max to approve (M5)") exports and
// imports a game.
import { Palette, Space, Radius, Size, Type, Icons } from "../theme.slint";
import { Icon, CIcon, Button, BtnKind, Card, Toggle, Segmented, Kbd, Slider } from "../components/base.slint";
import { VoiceData } from "../data.slint";
import { KeysCard } from "keys.slint";

component SetRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> first;
    height: root.desc != "" ? 63px : 57px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }
    HorizontalLayout {
        padding-left: Space.s5;
        padding-right: Space.s5;
        spacing: Space.s4;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                height: Type.lh2;
                font-weight: Type.w-medium;
                color: Palette.text;
                vertical-alignment: center;
            }

            if root.desc != "": Text {
                text: root.desc;
                height: Type.lh1;
                font-size: Type.fs1;
                color: Palette.text-3;
                vertical-alignment: center;
            }
        }

        @children
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: Space.s3;
    Text {
        text: root.title;
        height: 23px;
        font-size: Type.fs3;
        font-weight: Type.w-semibold;
        color: Palette.text;
        vertical-alignment: center;
    }

    @children
}

component RowToggle inherits VerticalLayout {
    in-out property <bool> on;
    in property <string> label;
    callback toggled(bool);
    alignment: center;
    Toggle {
        on: root.on;
        label: root.label;
        toggled(v) => {
            root.on = v;
            root.toggled(v);
        }
    }
}

export component SettingsTab inherits Rectangle {
    in-out property <bool> start-with-windows: true;
    in-out property <bool> open-minimized: true;
    in-out property <bool> show-in-taskbar: false;
    in-out property <int> pill-position: 0;
    in-out property <bool> show-speaker: true;
    in-out property <bool> auto-update: true;
    in property <string> read-key: "Mouse 4";
    in property <string> menu-key: "F7";
    in property <int> capturing: -1;
    in property <string> version: "";
    // under the version (the mockup text with the fake data; the app says what Check now does)
    in property <string> update-note: "You have the latest version.";
    // the automatic install row (the mockup shows it; the app hides it until updates can install, spec 6 item 2)
    in property <bool> show-auto-update: true;
    // a Startup or In-game overlay row changed (saved by src/vm/prefs.rs)
    callback changed();
    callback check-updates();
    callback export-game();
    callback import-game();
    // Voices: Kokoro (first, as in mockup 12) and the Windows voices, and the current game's voice, speed and
    // volume (saved in its profile)
    in property <[VoiceData]> voices;
    in property <string> voices-desc: "Built into Windows · 11 voices";
    in property <string> kokoro-desc: "Installed · 11 voices · 312 MB";
    in property <string> game: "Red Dead Redemption 2";
    in property <bool> has-game: true;
    in-out property <int> game-voice: 0;
    in-out property <float> game-speed: 0.55;
    in-out property <float> game-volume: 0.8;
    in property <bool> testing;
    callback add-voices();
    callback voice-picked(int);
    // a slider moves (sent to speech at once), then is let go (saved in the profile)
    callback voice-changed();
    callback voice-saved();
    callback test();
    callback stop-test();
    in-out property <int> section: 0;
    callback change-key(int);
    // opens the voice picker (render-screens shows it open)
    public function open-voice-list() {
        list.show();
    }
    public function close-voice-list() {
        list.close();
    }
    public function jump(i: int) {
        root.section = i;
        flick.content-y = -max(0px, min(
            i == 0 ? startup.y : i == 1 ? overlay.y : i == 2 ? keys.y : i == 3 ? voices.y : i == 4 ? updates.y : games.y,
            col.preferred-height + 2 * Size.page-x - flick.height));
    }
    HorizontalLayout {
        padding-left: Size.page-x;
        spacing: Space.s7;
        VerticalLayout {
            padding-top: Size.page-x;
            width: 200px;
            spacing: 2px;
            alignment: start;
            for s[i] in ["Startup", "In-game overlay", "Keys", "Voices", "Updates", "Games"]: Rectangle {
                height: Size.ctl;
                border-radius: Radius.md;
                background: i == root.section ? Palette.surface-2 : (nav-touch.has-hover ? Palette.surface : transparent);
                accessible-role: tab;
                accessible-label: s;
                accessible-item-selected: i == root.section;
                accessible-action-default => {
                    root.jump(i);
                }
                Text {
                    x: Space.s3;
                    text: s;
                    font-weight: Type.w-medium;
                    color: i == root.section ? Palette.text : Palette.text-2;
                    vertical-alignment: center;
                }

                nav-touch := TouchArea {
                    clicked => {
                        root.jump(i);
                    }
                }
            }
        }

        flick := Flickable {
            horizontal-stretch: 1;
            content-height: col.preferred-height + 2 * Size.page-x;
            col := VerticalLayout {
                x: (flick.width - 720px) / 2 - Size.page-x / 2;
                y: Size.page-x;
                width: 720px;
                spacing: Space.s6;
                alignment: start;
                startup := Section {
                    title: "Startup";
                    Card {
                        VerticalLayout {
                            padding: 1px;
                            SetRow {
                                first: true;
                                title: "Start with Windows";
                                desc: "Runs in the tray, ready when a game starts.";
                                RowToggle {
                                    on <=> root.start-with-windows;
                                    label: "Start with Windows";
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }

                            SetRow {
                                title: "Open minimized";
                                desc: "Skip the main window at startup.";
                                RowToggle {
                                    on <=> root.open-minimized;
                                    label: "Open minimized";
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }

                            SetRow {
                                title: "Show in the taskbar";
                                desc: "Otherwise only the tray icon shows.";
                                RowToggle {
                                    on <=> root.show-in-taskbar;
                                    label: "Show in the taskbar";
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }

                overlay := Section {
                    title: "In-game overlay";
                    Card {
                        VerticalLayout {
                            padding: 1px;
                            SetRow {
                                first: true;
                                title: "Position";
                                desc: "Where the small status pill sits.";
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        items: ["Top right", "Bottom center", "Off"];
                                        selected: root.pill-position;
                                        select(i) => {
                                            root.pill-position = i;
                                            root.changed();
                                        }
                                    }
                                }
                            }

                            SetRow {
                                title: "Show the speaker";
                                desc: "Otherwise only the status dot shows.";
                                RowToggle {
                                    on <=> root.show-speaker;
                                    label: "Show the speaker";
                                    toggled => {
                                        root.changed();
                                    }
                                }
                            }
                        }
                    }
                }

                keys := Section {
                    title: "Keys";
                    KeysCard {
                        read-key: root.read-key;
                        menu-key: root.menu-key;
                        capturing: root.capturing;
                        change(i) => {
                            root.change-key(i);
                        }
                    }
                }

                voices := Section {
                    title: "Voices";
                    Card {
                        VerticalLayout {
                            padding: 1px;
                            SetRow {
                                first: true;
                                title: "Kokoro";
                                desc: root.kokoro-desc;
                            }

                            SetRow {
                                title: "Windows voices";
                                desc: root.voices-desc;
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Add voices";
                                        icon: Icons.download;
                                        clicked => {
                                            root.add-voices();
                                        }
                                    }
                                }
                            }

                            SetRow {
                                title: "Voice for this game";
                                desc: root.has-game ? root.game : "Set up a game first.";
                                HorizontalLayout {
                                    spacing: Space.s2;
                                    alignment: end;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 200px;
                                            height: Size.ctl;
                                            border-radius: Radius.md;
                                            border-width: 1px;
                                            border-color: Palette.line-2;
                                            background: Palette.surface-2;
                                            accessible-role: combobox;
                                            accessible-label: "Voice for this game";
                                            accessible-value: root.voices.length > 0 ? root.voices[root.game-voice].name : "No voice";
                                            accessible-action-default => {
                                                if root.voices.length > 0 && root.has-game {
                                                    list.show();
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: Space.s3 + 1px;
                                                padding-right: Space.s3 + 1px;
                                                Text {
                                                    text: root.voices.length > 0 ? root.voices[root.game-voice].engine + " · " + root.voices[root.game-voice].name : "No voice";
                                                    color: Palette.text;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }

                                                CIcon {
                                                    source: Icons.chev-down;
                                                    color: Palette.text-2;
                                                }
                                            }

                                            TouchArea {
                                                clicked => {
                                                    if root.voices.length > 0 && root.has-game {
                                                        list.show();
                                                    }
                                                }
                                            }

                                            list := PopupWindow {
                                                x: 0;
                                                y: parent.height + Space.s1;
                                                width: parent.width;
                                                height: Math.min(root.voices.length, 6) * Size.ctl + 2 * Space.s1;
                                                Rectangle {
                                                    width: 100%;
                                                    height: 100%;
                                                    background: Palette.surface-2;
                                                    border-radius: Radius.md;
                                                    border-width: 1px;
                                                    border-color: Palette.line-2;
                                                    // six rows show; the rest scroll
                                                    Flickable {
                                                        x: Space.s1;
                                                        y: Space.s1;
                                                        width: parent.width - 2 * Space.s1;
                                                        height: Math.min(root.voices.length, 6) * Size.ctl;
                                                        content-height: root.voices.length * Size.ctl;
                                                    VerticalLayout {
                                                        for v[i] in root.voices: Rectangle {
                                                            height: Size.ctl;
                                                            border-radius: Radius.sm;
                                                            background: i == root.game-voice || row-touch.has-hover ? Palette.surface-3 : transparent;
                                                            accessible-role: list-item;
                                                            accessible-label: v.name;
                                                            accessible-item-selected: i == root.game-voice;
                                                            Text {
                                                                x: Space.s2;
                                                                text: v.name + "  ·  " + v.short;
                                                                color: Palette.text;
                                                                vertical-alignment: center;
                                                            }

                                                            row-touch := TouchArea {
                                                                clicked => {
                                                                    root.game-voice = i;
                                                                    root.voice-picked(i);
                                                                }
                                                            }
                                                        }
                                                    }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Button {
                                            text: root.testing ? "Stop" : "Test";
                                            label: "Test the voice";
                                            icon: root.testing ? Icons.stop : Icons.play;
                                            enabled: root.voices.length > 0 && root.has-game;
                                            clicked => {
                                                if root.testing {
                                                    root.stop-test();
                                                } else {
                                                    root.test();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            SetRow {
                                title: "Speed";
                                HorizontalLayout {
                                    spacing: Space.s3;
                                    width: 260px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Slider {
                                            value <=> root.game-speed;
                                            changed => {
                                                root.voice-changed();
                                            }
                                            released => {
                                                root.voice-saved();
                                            }
                                        }
                                    }

                                    Text {
                                        width: 40px;
                                        text: Math.round(Math.max(0.25, root.game-speed) * 20) / 10 + "×";
                                        font-family: Type.mono;
                                        font-size: Type.fs1;
                                        color: Palette.text-2;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            SetRow {
                                title: "Volume";
                                HorizontalLayout {
                                    spacing: Space.s3;
                                    width: 260px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Slider {
                                            value <=> root.game-volume;
                                            changed => {
                                                root.voice-changed();
                                            }
                                            released => {
                                                root.voice-saved();
                                            }
                                        }
                                    }

                                    Text {
                                        width: 40px;
                                        text: Math.round(root.game-volume * 100) + "%";
                                        font-family: Type.mono;
                                        font-size: Type.fs1;
                                        color: Palette.text-2;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                updates := Section {
                    title: "Updates";
                    Card {
                        VerticalLayout {
                            padding: 1px;
                            SetRow {
                                first: true;
                                title: "Version " + root.version;
                                desc: root.update-note;
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Check now";
                                        icon: Icons.refresh;
                                        clicked => {
                                            root.check-updates();
                                        }
                                    }
                                }
                            }

                            if root.show-auto-update: SetRow {
                                title: "Install updates automatically";
                                desc: "Only when no game is running.";
                                RowToggle {
                                    on <=> root.auto-update;
                                    label: "Install updates automatically";
                                }
                            }
                        }
                    }
                }

                games := Section {
                    title: "Games";
                    Card {
                        VerticalLayout {
                            padding: 1px;
                            SetRow {
                                first: true;
                                title: "Export this game";
                                desc: root.has-game ? root.game : "Set up a game first.";
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Export";
                                        icon: Icons.download;
                                        enabled: root.has-game;
                                        clicked => {
                                            root.export-game();
                                        }
                                    }
                                }
                            }

                            SetRow {
                                title: "Import a game";
                                desc: "Adds a game from an exported file.";
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Import";
                                        icon: Icons.upload;
                                        clicked => {
                                            root.import-game();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
