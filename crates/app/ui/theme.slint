// Fake game art for M1 (from the mockups). From M2 on, real screenshots take their place.
export global Art {
    out property <image> scene: @image-url("art/scene.svg");
    // the same scene drawn by Chromium at 1440 x 900 (as in the mockups). Software renders of the full-window
    // overlay previews use it: a 1:1 copy with no scaling, so they line up with the mockup shots. The real
    // window keeps the SVG, which stays sharp at any window size.
    out property <image> scene-full: @image-url("art/scene-1440.png");
    out property <image> rdr2: @image-url("art/rdr2.svg");
    out property <image> satis: @image-url("art/satis.svg");
    out property <image> p4g: @image-url("art/p4g.svg");
    out property <image> e33: @image-url("art/e33.svg");
    out property <image> kcd2: @image-url("art/kcd2.svg");
    public pure function get(key: string) -> image {
        if key == "rdr2" { return self.rdr2; }
        if key == "satis" { return self.satis; }
        if key == "p4g" { return self.p4g; }
        if key == "e33" { return self.e33; }
        if key == "kcd2" { return self.kcd2; }
        return self.scene;
    }
}
