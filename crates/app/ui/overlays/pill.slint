// 13 in-game status pill: dot, speaker, small live waveform.
import { Palette, Render, Shadow, Space, Radius, Size, Type, Icons, Art } from "../theme.slint";
import { Dot, PillWave } from "../components/base.slint";

// The small in-game pill (13), reused on the welcome preview.
export component OverlayPill inherits Rectangle {
    in property <string> speaker: "Arthur";
    // the overlay window (M4): green dot while reading, grey otherwise; the wave is lit while a line is spoken
    in property <bool> ok: true;
    in property <bool> speaking: true;
    height: 32px;
    width: row.preferred-width;
    border-radius: 16px;
    background: Palette.pill-bg;
    border-width: 1px;
    border-color: Palette.pill-line;
    drop-shadow-offset-y: Shadow.low-y;
    drop-shadow-blur: Shadow.low-blur;
    drop-shadow-color: Shadow.low-color;
    row := HorizontalLayout {
        padding-left: Space.s3 + 1px;
        padding-right: Space.s3 + 1px;
        spacing: Space.s2;
        VerticalLayout {
            alignment: center;
            Dot {
                size: 6px;
                tint: root.ok ? Palette.ok : Palette.text-3;
            }
        }

        if root.speaker != "": Text {
            text: root.speaker;
            font-size: Type.fs1;
            font-weight: Type.w-medium;
            color: Palette.text;
            vertical-alignment: center;
            max-width: 200px;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            PillWave {
                played: root.speaking ? 999 : 0;
            }
        }
    }
}


// Preview of the pill over the game (13-overlay). The real pill is a click-through overlay window (M4).
export component PillPreview inherits Rectangle {
    Image {
        width: 100%;
        height: 100%;
        source: Render.software ? Art.scene-full : Art.scene;
        image-fit: cover;
    }

    OverlayPill {
        x: parent.width - self.width - 24px;
        y: 24px;
    }
}
