// 16-zone-edit: in-game zone editing from the quick menu.
// Drag on empty space adds a zone, click selects it, Delete / Backspace or the small x removes it, Esc finishes.
import { Palette, Render, Shadow, Space, Radius, Size, Type, Icons, Art, Kind, Kinds } from "../theme.slint";
import { EditZone } from "../data.slint";
import { Icon, CIcon } from "../components/base.slint";

component Badge inherits Rectangle {
    in property <Kind> kind;
    in property <bool> sel;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: root.sel ? Palette.accent : Palette.panel;
    border-width: 1px;
    border-color: root.sel ? Palette.accent : Palette.line-2;
    Icon {
        source: Kinds.icon(root.kind);
        width: 14px;
        height: 14px;
        color: root.sel ? Palette.on-accent : Palette.text-3;
    }
}

export component ZoneEdit inherits Rectangle {
    in-out property <[EditZone]> zones;
    in-out property <int> selected: -1;
    // dim layer: one even-odd path, the frame minus every zone (built in Rust, geom::dim_path)
    in property <string> dim-commands;
    // the zone being drawn (frame px); shown with the kind picker until a kind is chosen
    in-out property <bool> draft: false;
    in-out property <length> draft-x;
    in-out property <length> draft-y;
    in-out property <length> draft-w;
    in-out property <length> draft-h;
    in-out property <Kind> draft-kind: Kind.dialogue;
    property <length> press-x;
    property <length> press-y;
    property <bool> dragging: false;
    // the overlay window (M4): the frozen screenshot of the game, stretched over the window
    in property <bool> real-shot: false;
    in property <image> shot;
    callback done();
    callback remove(int);
    callback commit(Kind);
    callback pick(length, length) -> int;
    public function key(k: string) -> bool {
        if k == Key.Delete || k == Key.Backspace {
            if root.selected >= 0 {
                root.remove(root.selected);
            }
            return true;
        }
        if k == Key.Escape {
            if root.draft {
                root.draft = false;
            } else {
                root.done();
            }
            return true;
        }
        return false;
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.real-shot ? root.shot : Render.software ? Art.scene-full : Art.scene;
        image-fit: root.real-shot ? fill : cover;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill-rule: evenodd;
        fill: Palette.edit-shade;
        commands: root.dim-commands;
    }

    // drawing and selecting
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.dragging = false;
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if root.dragging {
                    root.dragging = false;
                    root.draft = root.draft-w >= 16px && root.draft-h >= 12px;
                } else {
                    root.draft = false;
                    root.selected = root.pick(self.mouse-x, self.mouse-y);
                }
            }
        }
        moved => {
            if self.pressed && (abs(self.mouse-x - root.press-x) > 4px || abs(self.mouse-y - root.press-y) > 4px) {
                root.dragging = true;
                root.draft = true;
                root.selected = -1;
                root.draft-x = min(root.press-x, self.mouse-x);
                root.draft-y = min(root.press-y, self.mouse-y);
                root.draft-w = abs(self.mouse-x - root.press-x);
                root.draft-h = abs(self.mouse-y - root.press-y);
            }
        }
    }

    for z[i] in root.zones: Rectangle {
        property <bool> sel: i == root.selected;
        x: z.x;
        y: z.y;
        width: z.w;
        height: z.h;
        border-radius: 4px;
        border-width: self.sel ? 2px : 1px;
        border-color: self.sel ? Palette.accent : Palette.edit-line;
        background: self.sel ? Palette.edit-sel-fill : transparent;
        if sel: Rectangle {
            x: -5px;
            y: -5px;
            width: parent.width + 10px;
            height: parent.height + 10px;
            border-radius: 7px;
            border-width: 3px;
            border-color: Palette.edit-sel-ring;
        }
        Badge {
            x: sel ? -2px : -1px;
            y: -self.height - 6px;
            kind: z.kind;
            sel: sel;
        }

        if sel: Rectangle {
            for p in [{ x: 0, y: 0 }, { x: 0.5, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 0.5, y: 1 }, { x: 1, y: 1 }, { x: 0, y: 0.5 }, { x: 1, y: 0.5 }]: Rectangle {
                x: parent.width * p.x - 4.5px;
                y: parent.height * p.y - 4.5px;
                width: 9px;
                height: 9px;
                border-radius: 2px;
                background: Palette.knob;
                border-width: 1.5px;
                border-color: Palette.accent;
            }
        }
        if sel: Rectangle {
            x: parent.width + 6px;
            y: -30px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.line-2;
            accessible-role: button;
            accessible-label: "Remove zone";
            accessible-action-default => {
                root.remove(i);
            }
            Icon {
                source: Icons.x-sm;
                width: 13px;
                height: 13px;
                color: Palette.text;
            }

            TouchArea {
                clicked => {
                    root.remove(i);
                }
            }
        }
    }

    // the new zone and its kind picker
    if root.draft: Rectangle {
        x: root.draft-x;
        y: root.draft-y;
        width: root.draft-w;
        height: root.draft-h;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: Palette.edit-draft-line;
        background: Palette.edit-draft-fill;
        Icon {
            x: parent.width - 11px;
            y: parent.height - 11px;
            width: 22px;
            height: 22px;
            source: Icons.cross;
            colorize: Palette.on-accent;
        }

        Rectangle {
            x: parent.width + 6px;
            y: parent.height + 10px;
            height: 22px;
            width: size-text.preferred-width + 18px;
            border-radius: 6px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.line-2;
            size-text := Text {
                text: Math.round(root.draft-w / 1px) + " × " + Math.round(root.draft-h / 1px);
                font-size: Type.fs1;
                font-weight: Type.w-medium;
                color: Palette.text-2;
            }
        }
    }
    if root.draft: Rectangle {
        x: root.draft-x;
        y: root.draft-y + root.draft-h + 10px;
        width: picker.preferred-width;
        height: 42px;
        border-radius: 10px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.line-2;
        drop-shadow-offset-y: Shadow.pop-y;
        drop-shadow-blur: Shadow.pop-blur;
        drop-shadow-color: Shadow.pop-color;
        picker := HorizontalLayout {
            padding: 5px;
            spacing: 2px;
            for k in [Kind.dialogue, Kind.speaker, Kind.pickups, Kind.prompts, Kind.ignore]: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 7px;
                background: k == root.draft-kind ? Palette.surface-3 : transparent;
                accessible-role: button;
                accessible-label: Kinds.name(k);
                accessible-action-default => {
                    root.draft-kind = k;
                    root.commit(k);
                }
                Icon {
                    source: Kinds.icon(k);
                    color: k == root.draft-kind ? Palette.text : Palette.text-3;
                }

                TouchArea {
                    clicked => {
                        root.draft-kind = k;
                        root.commit(k);
                    }
                }
            }
        }

        Rectangle {
            x: 4px;
            y: parent.height + 6px;
            height: 22px;
            width: tip.preferred-width + 16px;
            border-radius: 6px;
            background: Palette.surface-3;
            tip := Text {
                text: Kinds.name(root.draft-kind);
                font-size: Type.fs1;
                font-weight: Type.w-medium;
                color: Palette.text;
            }
        }
    }

    // hint bar with Done
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: bar.preferred-width;
        height: 44px;
        border-radius: 22px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.line-2;
        drop-shadow-offset-y: Shadow.pop-y;
        drop-shadow-blur: Shadow.pop-blur;
        drop-shadow-color: Shadow.pop-color;
        bar := HorizontalLayout {
            padding-left: 17px;
            padding-right: 7px;
            spacing: 16px;
            HorizontalLayout {
                spacing: Space.s2;
                CIcon {
                    source: Icons.zone;
                    color: Palette.text-2;
                }

                Text {
                    text: "Zones";
                    font-size: 13px;
                    font-weight: Type.w-semibold;
                    color: Palette.text;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 1px;
                    height: 18px;
                    background: Palette.line-2;
                }
            }

            for h[i] in [{ b: "Drag", t: "to add" }, { b: "Click", t: "to select" }, { b: "Delete", t: "to remove" }, { b: "Esc", t: "to finish" }]: HorizontalLayout {
                spacing: 16px;
                if i > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Palette.line-2;
                    }
                }
                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: h.b;
                        font-size: Type.fs1;
                        font-weight: Type.w-semibold;
                        color: Palette.text-2;
                        vertical-alignment: center;
                    }

                    Text {
                        text: h.t;
                        font-size: Type.fs1;
                        font-weight: Type.w-medium;
                        color: Palette.text-3;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: done-text.preferred-width + 32px;
                    border-radius: 16px;
                    background: Palette.accent;
                    accessible-role: button;
                    accessible-label: "Done";
                    accessible-action-default => {
                        root.done();
                    }
                    done-text := Text {
                        text: "Done";
                        font-size: 13px;
                        font-weight: Type.w-semibold;
                        color: Palette.on-accent;
                    }

                    TouchArea {
                        clicked => {
                            root.done();
                        }
                    }
                }
            }
        }
    }
}
