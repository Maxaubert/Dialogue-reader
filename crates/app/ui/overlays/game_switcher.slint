// 14 game switcher (d-black 14-game-switcher): a scrim under the title strip and a panel under the game name.
// The game name or Ctrl K opens it. Type to search; Up and Down move the highlight (it glides 120 ms); Enter
// switches; Esc or a click outside closes it. Rust filters the games (`hits`, src/vm/mod.rs).
// Delete a game (Max, 2026-11-24): the highlighted row has a trash button at its right end (the Delete key, with
// an empty search, does the same). It asks first: the button becomes a small "Delete" on that row, which Enter or
// a click confirms. Esc, another row or the mouse leaving the row cancels it. A click on "Delete" in the first 500 ms after the ask does
// nothing: "Delete" sits where the trash button was, so a double click must not delete (Max: not one misclick).
// Motion (README, 7 and 8): scrim 0 to 0.6, panel opacity, y -8 to 0 and scale 0.98 to 1, 180 ms ease-out;
// close 140 ms ease-in.
import {
    Palette,
    Space,
    Radius,
    Size,
    Type,
    Motion,
    Icons,
} from "../theme.slint";
import { GameData } from "../data.slint";
import {
    CIcon,
    Icon,
    Thumb,
    IconButton,
    Button,
    BtnKind,
} from "../components/base.slint";

// One game row (.gr): picture, name, and "Reading" or when it was last played on the right. The highlighted row
// ends with a trash button; while `confirm`, a "Delete" button instead.
component GameItem inherits Rectangle {
    in property <GameData> game;
    in property <bool> current;
    in property <bool> hi;
    in property <bool> confirm;
    callback clicked();
    callback hovered();
    // the mouse left the row
    callback left();
    callback delete-asked();
    callback delete-confirmed();
    height: Size.media;
    accessible-role: list-item;
    accessible-label: root.game.name;
    accessible-item-selected: root.hi;
    accessible-action-default => {
        root.clicked();
    }
    // the row's buttons are inside its TouchArea, so the row keeps its hover while the mouse is on them
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            } else {
                root.left();
            }
        }

        HorizontalLayout {
            padding-left: Space.s2;
            padding-right: root.hi || root.confirm ? Space.s2 : Space.s3;
            spacing: Space.s3;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 27px;
                    Thumb {
                        width: 100%;
                        height: 100%;
                        art: root.game.art;
                        picture: root.game.cover;
                        radius: Radius.sm;
                        behind: root.hi ? Palette.surface-3 : Palette.surface-1;
                    }

                    Rectangle {
                        border-radius: Radius.sm;
                        border-width: 1px;
                        border-color: Palette.line;
                    }
                }
            }

            Text {
                text: root.game.name;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                // the row carries the name (a Text with it would count as the strip's game name)
                accessible-role: none;
            }

            Text {
                text: root.game.meta;
                font-size: Type.fs-small;
                color: Palette.text-2;
                vertical-alignment: center;
                accessible-role: none;
            }

            if root.hi && !root.confirm: VerticalLayout {
                alignment: center;
                IconButton {
                    small: true;
                    icon: Icons.trash;
                    tip: "Delete game";
                    label: "Delete " + root.game.name;
                    clicked => {
                        root.delete-asked();
                    }
                }
            }
            if root.confirm: VerticalLayout {
                alignment: center;
                Button {
                    kind: BtnKind.danger;
                    text: "Delete";
                    label: "Confirm delete " + root.game.name;
                    height: 28px;
                    clicked => {
                        root.delete-confirmed();
                    }
                }
            }
        }
    }
}

export component GameSwitcher inherits Rectangle {
    in property <bool> open;
    in property <[GameData]> games;
    // the games shown, as indices into `games` (all of them until a search narrows them)
    in property <[int]> hits;
    in property <int> current: 0;
    // the highlighted row: a place in `hits`
    in-out property <int> highlight: 1;
    in-out property <string> query;
    // the highlight moved with the mouse: it glides 360 ms (keys: 120 ms)
    property <bool> by-mouse: false;
    // the row (a place in `hits`) that asks "Delete?" now (-1: none)
    in-out property <int> confirm: -1;
    // when the row asked (animation-tick): a click on "Delete" that comes too soon is the second click of a
    // double click on the trash button
    property <duration> asked-at;
    callback close();
    // a game was picked (its index in `games`)
    callback choose(int);
    callback add-game();
    callback search(string);
    // Delete was confirmed (the game's index in `games`)
    callback delete-game(int);
    // the switcher opened: an empty search, the highlight on the first game that is not the current one
    changed open => {
        if root.open {
            root.query = "";
            root.search("");
            root.confirm = -1;
            root.highlight = root.current == 0 && root.games.length > 1 ? 1 : 0;
        }
    }

    public function focus-search() {
        search.focus();
    }
    public function step(d: int) {
        root.by-mouse = false;
        // another row: a Delete that was asked is off
        root.confirm = -1;
        root.highlight = Math.max(0, Math.min(root.hits.length - 1, root.highlight + d));
    }
    // Enter: switches to the highlighted game, or deletes it while it asks
    public function pick() {
        if root.confirm >= 0 {
            root.confirm-delete();
            return;
        }
        if root.highlight >= 0 && root.highlight < root.hits.length {
            root.choose(root.hits[root.highlight]);
        }
    }
    // the trash button or the Delete key: the highlighted row asks first
    public function ask-delete() {
        if root.highlight >= 0 && root.highlight < root.hits.length {
            root.confirm = root.highlight;
            root.asked-at = animation-tick();
        }
    }
    // Esc: a Delete that was asked is off (true), or there was none (false: Esc closes the switcher)
    public function cancel-delete() -> bool {
        if root.confirm < 0 {
            return false;
        }
        root.confirm = -1;
        true
    }
    function confirm-delete() {
        if root.confirm < 0 || root.confirm >= root.hits.length {
            root.confirm = -1;
            return;
        }
        let gi = root.hits[root.confirm];
        root.confirm = -1;
        root.delete-game(gi);
        // the list is shorter now (Rust set `hits`)
        root.by-mouse = false;
        root.highlight = Math.max(0, Math.min(root.highlight, root.hits.length - 1));
    }
    property <float> t: root.open ? 1 : 0;
    animate t {
        duration: root.open ? Motion.base : Motion.exit;
        easing: root.open ? cubic-bezier(0.2, 0.7, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1);
    }
    // visible as soon as it opens, while t is still 0: Ctrl K gives the search field the keys in the same step,
    // and Slint takes the focus away from an item that is hidden (after a page push the opening starts at
    // t = 0, so typing, Down and Enter did nothing)
    visible: root.open || self.t > 0.01;

    // scrim under the title strip; a click on it closes the switcher
    Rectangle {
        y: Size.strip;
        height: parent.height - Size.strip;
        background: #000000;
        opacity: 0.6 * root.t;
        TouchArea {
            clicked => {
                root.close();
            }
        }
    }

    panel := Rectangle {
        x: 12px;
        y: 44px + (1 - root.t) * -8px * Motion.move;
        width: 480px;
        height: col.preferred-height + 2px;
        opacity: root.t;
        transform-scale: 1 - 0.02 * (1 - root.t) * Motion.move;
        transform-origin: { x: self.width * 0.3, y: 0px };
        border-radius: Radius.lg;
        border-width: 1px;
        border-color: Palette.float-line;
        background: Palette.float;
        drop-shadow-offset-y: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000099;
        TouchArea { }

        col := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            // search (.sws): 48 px with the line under it
            HorizontalLayout {
                height: Size.media - 1px;
                padding-left: Space.s4;
                padding-right: Space.s3;
                spacing: Space.s3;
                CIcon {
                    source: Icons.search;
                    color: Palette.text-2;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    if root.query == "": Text {
                        x: 0;
                        text: "Search games";
                        color: Palette.text-2;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    FocusScope {
                        // Up, Down, Enter and Esc work while the search field has the keys
                        capture-key-pressed(e) => {
                            if !root.open {
                                return reject;
                            }
                            if e.text == Key.UpArrow {
                                root.step(-1);
                                return accept;
                            }
                            if e.text == Key.DownArrow {
                                root.step(1);
                                return accept;
                            }
                            if e.text == Key.Return {
                                root.pick();
                                return accept;
                            }
                            // Delete asks only with an empty search: with text, it deletes a character
                            if e.text == Key.Delete && root.query == "" && root.hits.length > 0 {
                                root.ask-delete();
                                return accept;
                            }
                            if e.text == Key.Escape {
                                if !root.cancel-delete() {
                                    root.close();
                                }
                                return accept;
                            }
                            reject
                        }
                        search := TextInput {
                            text <=> root.query;
                            color: Palette.text;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-label: "Search games";
                            edited => {
                                root.confirm = -1;
                                root.search(self.text);
                                root.highlight = 0;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: Size.keycap-sm;
                        width: ck.preferred-width + 2 * Space.s2 + 2px;
                        border-radius: Radius.sm;
                        border-width: 1px;
                        border-color: Palette.line-2;
                        background: Palette.surface-2;
                        ck := Text {
                            text: "Ctrl K";
                            font-family: Type.mono;
                            font-size: Type.fs-small;
                            font-weight: Type.w-regular;
                            color: Palette.text;
                            accessible-role: none;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.line;
            }

            // the games (.swl)
            Rectangle {
                height: list.preferred-height;
                Rectangle {
                    x: Space.s1;
                    y: Space.s1 + Math.max(0, root.highlight) * Size.media;
                    width: parent.width - 2 * Space.s1;
                    height: Size.media;
                    visible: root.hits.length > 0;
                    border-radius: Radius.md;
                    background: Palette.surface-3;
                    animate y {
                        duration: root.by-mouse ? Motion.glide : Motion.slide(120ms);
                        easing: cubic-bezier(0.16, 1, 0.3, 1);
                    }
                }

                list := VerticalLayout {
                    padding: Space.s1;
                    for gi[j] in root.hits: GameItem {
                        game: root.games[gi];
                        current: gi == root.current;
                        hi: j == root.highlight;
                        confirm: j == root.confirm;
                        clicked => {
                            root.choose(gi);
                        }
                        hovered => {
                            if root.highlight != j {
                                root.confirm = -1;
                            }
                            root.by-mouse = true;
                            root.highlight = j;
                        }
                        left => {
                            if root.confirm == j {
                                root.confirm = -1;
                            }
                        }
                        delete-asked => {
                            root.highlight = j;
                            root.confirm = j;
                            root.asked-at = animation-tick();
                        }
                        delete-confirmed => {
                            if animation-tick() - root.asked-at < 500ms {
                                return;
                            }
                            root.confirm = j;
                            root.confirm-delete();
                        }
                    }
                    if root.hits.length == 0: HorizontalLayout {
                        height: Size.media;
                        padding-left: Space.s3;
                        Text {
                            text: "No games found.";
                            color: Palette.text-2;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.line;
            }

            // Add game (.swf)
            VerticalLayout {
                padding: Space.s1;
                Rectangle {
                    height: Size.media;
                    border-radius: Radius.md;
                    background: add-touch.has-hover ? Palette.surface-2 : transparent;
                    accessible-role: button;
                    accessible-label: "Add game";
                    accessible-description: "Opens setup";
                    accessible-action-default => {
                        root.add-game();
                    }
                    add-touch := TouchArea {
                        clicked => {
                            root.add-game();
                        }
                    }

                    HorizontalLayout {
                        padding-left: Space.s2;
                        padding-right: Space.s3;
                        spacing: Space.s3;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 27px;
                                border-radius: Radius.sm;
                                border-width: 1px;
                                border-color: Palette.line;
                                background: Palette.surface-2;
                                Icon {
                                    width: Size.icon-lg;
                                    height: Size.icon-lg;
                                    source: Icons.plus;
                                    color: Palette.text-2;
                                }
                            }
                        }

                        Text {
                            text: "Add game";
                            color: add-touch.has-hover ? Palette.text : Palette.text-2;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                    }

                    Tooltip {
                        Rectangle {
                            border-radius: Radius.md;
                            border-width: 1px;
                            border-color: Palette.line-2;
                            background: Palette.surface-2;
                            HorizontalLayout {
                                padding-left: Space.s2;
                                padding-right: Space.s2;
                                padding-top: Space.s1;
                                padding-bottom: Space.s1;
                                Text {
                                    text: "Opens setup";
                                    font-size: Type.fs-small;
                                    color: Palette.text;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // while it fades out, the switcher takes no clicks
    if !root.open: TouchArea { }
}
