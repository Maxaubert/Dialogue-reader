// 15 quick menu (d-black 15-quick-menu): the in-game menu and its voice list. This file holds what the overlay
// window (M4) needs; the review preview is in quick_menu_preview.slint.
// Rows: Edit zones, Stop, Mute, Voice, Speed, Volume, Mode, Settings, Quit (press twice). The header shows the
// game and a small status, as the game has no title strip. No key hints (one place for key hints: the switcher).
// One highlight glides between the rows (120 ms, keys). Keys come from the low-level hook, never from focus.
import { Palette, Space, Radius, Size, Type, Motion, Icons, Speeds } from "../theme.slint";
import { VoiceData } from "../data.slint";
import { Icon, CIcon, Toggle, Segmented, Slider, Dot } from "../components/base.slint";

// The app's speed range (SPEED_MIN, SPEED_MAX in src/overlay/quick_menu.rs): the slider runs 0.5x to 2.0x.
export global QmSpeed {
    out property <float> min: Speeds.min;
    out property <float> max: Speeds.max;
    public pure function text(s: float) -> string {
        return Speeds.text(s);
    }
}

// One menu row (.qr): icon, label, and the value on the right (children). `arm`: Quit pressed once.
export component QmRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> arm;
    in property <length> row-h: Size.row;
    callback clicked();
    height: root.row-h;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Space.s3;
        padding-right: Space.s2;
        spacing: Space.s3;
        CIcon {
            source: root.icon;
            color: root.arm ? Palette.danger : Palette.text-2;
        }

        Text {
            text: root.text;
            color: root.arm ? Palette.danger : Palette.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        @children
    }
}

// The hairline between row groups (.sep): full width, 4 px above and below.
component QmSep inherits Rectangle {
    height: 9px;
    Rectangle {
        x: -Space.s1;
        y: Space.s1;
        width: parent.width + 2 * Space.s1;
        height: 1px;
        background: Palette.line;
    }
}

// The small status in the header: lime dot and "Reading", or a grey dot and "Stopped".
export component QmStatus inherits HorizontalLayout {
    in property <bool> on: true;
    spacing: Space.s2;
    horizontal-stretch: 0;
    VerticalLayout {
        alignment: center;
        Dot {
            size: 8px;
            tint: root.on ? Palette.live : Palette.text-2;
        }
    }

    Text {
        text: root.on ? "Reading" : "Stopped";
        font-size: Type.fs-small;
        color: Palette.text-2;
        vertical-alignment: center;
    }
}

// A slider with its value on the right (.qr .slider): 112 px track, the value in text color.
component QmSlider inherits HorizontalLayout {
    in-out property <float> value;
    in property <string> label;
    in property <string> shown;
    callback moved(float);
    callback let-go(float);
    spacing: Space.s3;
    VerticalLayout {
        alignment: center;
        Slider {
            width: 112px;
            label: root.label;
            value <=> root.value;
            changed(v) => {
                root.moved(v);
            }
            released(v) => {
                root.let-go(v);
            }
        }
    }

    Text {
        width: 36px;
        text: root.shown;
        color: Palette.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// The quick menu panel (.qm): 400 px, opaque, radius 10. All state is plain properties; the overlay window (M4)
// drives them from the key hook.
export component QuickMenu inherits Rectangle {
    in property <string> game: "Red Dead Redemption 2";
    in-out property <int> highlight: 0;
    in-out property <bool> stopped: false;
    in-out property <bool> muted: false;
    in-out property <string> voice: "Adam";
    // the speed as text ("1.1x") and its slider place (0 to 1 over 0.5x to 2.0x)
    in-out property <float> speed: 1.1;
    in-out property <float> speed-pos: (root.speed - QmSpeed.min) / (QmSpeed.max - QmSpeed.min);
    in-out property <float> volume: 0.8;
    in-out property <bool> automatic: true;
    in-out property <bool> quit-armed: false;
    in property <bool> voice-open: false;
    callback activate(int);
    // mouse on the sliders and the mode buttons (the overlay window saves them)
    callback speed-moved(float);
    callback speed-let-go(float);
    callback volume-moved(float);
    callback volume-let-go(float);
    callback mode-picked(bool);
    // where row `i` starts in the list (rows 44 px, a 9 px line after rows 0, 2 and 6)
    pure function row-y(i: int) -> length {
        return Space.s1 + i * Size.row + (i >= 1 ? 9px : 0px) + (i >= 3 ? 9px : 0px) + (i >= 7 ? 9px : 0px);
    }
    // the top of the voice list beside the Voice row (the window places it), in panel px
    out property <length> voice-y: head.height + 1px + root.row-y(3) - Space.s1;
    width: 400px;
    height: col.preferred-height + 2px;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Palette.float-line;
    background: Palette.float;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;
    col := VerticalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        // 48 px with the line under it (.qm-h)
        head := HorizontalLayout {
            height: 47px;
            padding-left: Space.s4;
            padding-right: Space.s4;
            spacing: Space.s2;
            Text {
                text: root.game;
                font-weight: Type.w-strong;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            QmStatus {
                on: !root.stopped;
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.line;
        }

        list := Rectangle {
            height: lay.preferred-height;
            // the highlight glides to the row the keys are on
            Rectangle {
                x: Space.s1;
                y: root.row-y(root.voice-open ? 3 : root.highlight);
                width: parent.width - 2 * Space.s1;
                height: Size.row;
                border-radius: Radius.md;
                background: Palette.surface-3;
                animate y {
                    duration: Motion.fast;
                    easing: cubic-bezier(0.16, 1, 0.3, 1);
                }
            }

            lay := VerticalLayout {
                padding: Space.s1;
                QmRow {
                    icon: Icons.zone;
                    text: "Edit zones";
                    clicked => {
                        root.activate(0);
                    }
                    CIcon {
                        source: Icons.chev-right;
                        size: 14px;
                    }
                }

                QmSep { }

                QmRow {
                    icon: root.stopped ? Icons.resume : Icons.stop;
                    text: root.stopped ? "Resume" : "Stop";
                    clicked => {
                        root.activate(1);
                    }
                }

                QmRow {
                    icon: @image-url("../icons/mute.svg");
                    text: "Mute";
                    clicked => {
                        root.activate(2);
                    }
                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: root.muted;
                            label: "Mute";
                            toggled(v) => {
                                root.activate(2);
                            }
                        }
                    }
                }

                QmSep { }

                QmRow {
                    icon: Icons.k-speaker;
                    text: "Voice";
                    clicked => {
                        root.activate(3);
                    }
                    HorizontalLayout {
                        spacing: Space.s1;
                        Text {
                            text: root.voice;
                            color: Palette.text-2;
                            vertical-alignment: center;
                        }

                        CIcon {
                            source: Icons.chev-right;
                            size: 14px;
                        }
                    }
                }

                QmRow {
                    icon: Icons.speed;
                    text: "Speed";
                    QmSlider {
                        label: "Speed";
                        value <=> root.speed-pos;
                        shown: QmSpeed.text(root.speed);
                        moved(v) => {
                            root.speed-moved(v);
                        }
                        let-go(v) => {
                            root.speed-let-go(v);
                        }
                    }
                }

                QmRow {
                    icon: Icons.volume;
                    text: "Volume";
                    QmSlider {
                        label: "Volume";
                        value <=> root.volume;
                        shown: Math.round(root.volume * 100) + "%";
                        moved(v) => {
                            root.volume-moved(v);
                        }
                        let-go(v) => {
                            root.volume-let-go(v);
                        }
                    }
                }

                QmRow {
                    icon: Icons.zap;
                    text: "Mode";
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            items: ["Automatic", "On key press"];
                            selected: root.automatic ? 0 : 1;
                            select(i) => {
                                root.automatic = i == 0;
                                root.mode-picked(i == 0);
                            }
                        }
                    }
                }

                QmSep { }

                QmRow {
                    icon: Icons.settings;
                    text: "Settings";
                    clicked => {
                        root.activate(7);
                    }
                    CIcon {
                        source: Icons.open;
                        size: 14px;
                    }
                }

                QmRow {
                    icon: Icons.power;
                    text: "Quit";
                    arm: root.quit-armed;
                    clicked => {
                        root.activate(8);
                    }
                    if root.quit-armed: Text {
                        text: "Press again to quit";
                        color: Palette.danger;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The voice list beside the Voice row (.qv): 248 px, rows 36, a check on the chosen voice, "US · Male" on the
// right. Up and Down move the highlight; Space plays a sample; Enter chooses (src/overlay/quick_menu.rs).
export component QmVoices inherits Rectangle {
    in property <[VoiceData]> voices;
    in property <int> chosen: 0;
    in-out property <int> highlight: 1;
    callback choose(int);
    width: 248px;
    height: lay.preferred-height + 2px;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Palette.float-line;
    background: Palette.float;
    drop-shadow-offset-y: 12px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;
    Rectangle {
        x: 1px + Space.s1;
        y: 1px + Space.s1 + Math.max(0, root.highlight) * Size.list;
        width: parent.width - 2px - 2 * Space.s1;
        height: Size.list;
        visible: root.highlight >= 0 && root.highlight < root.voices.length;
        border-radius: Radius.md;
        background: Palette.surface-3;
        animate y {
            duration: Motion.fast;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    lay := VerticalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        padding: Space.s1;
        for v[i] in root.voices: Rectangle {
            property <bool> sel: i == root.chosen;
            height: Size.list;
            accessible-role: list-item;
            accessible-label: v.name;
            accessible-item-selected: self.sel;
            accessible-action-default => {
                root.choose(i);
            }
            TouchArea {
                clicked => {
                    root.choose(i);
                }
            }

            HorizontalLayout {
                padding-left: Space.s3;
                padding-right: Space.s2;
                spacing: Space.s3;
                Rectangle {
                    width: 16px;
                    if sel: CIcon {
                        source: Icons.check;
                        color: Palette.text;
                    }
                }

                Text {
                    text: v.name;
                    color: Palette.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }

                Text {
                    text: v.short;
                    font-size: Type.fs-small;
                    color: Palette.text-2;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}
