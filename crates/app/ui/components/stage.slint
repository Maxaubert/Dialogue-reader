// The game picture with zones on top (.stage, .zone, .ztag, .handle), the zone list row and the zone tools.
import { Palette, Render, Space, Radius, Size, Type, Icons, Art, Kind, Kinds } from "../theme.slint";
import { ZoneData } from "../data.slint";
import { Icon, CIcon, Button, Toggle, CornerMask, Dot, ZoneOutline } from "base.slint";

// The live view of the game (src/vm/live.rs). Rust sets it; every real stage (`contain`) shows it while `on`.
// Zones stay in capture pixels: `w` x `h` is the capture size, `frame` is a smaller copy that fills the same box.
export global LiveView {
    in-out property <bool> on: false;
    in-out property <image> frame;
    in-out property <float> w: 1600;
    in-out property <float> h: 900;
    // "Live", or why the saved screenshot shows (plain words); empty: no chip
    in-out property <string> note;
    in-out property <bool> note-live: false;
    // a real stage was shown or changed size (logical px): the frames are made this size
    callback stage-size(length, length);
    // a frame or the end of the session waits (called on the UI thread)
    callback arrived();
}

// Maps image pixels (src-w x src-h, shown with "cover", or "contain" for real screenshots) to view pixels.
// Rust has the same math in geom.rs. With `interactive`, presses, drags and releases go to `pointer` in image
// pixels (src/vm/zones.rs draws, selects, moves and resizes).
export component Stage inherits Rectangle {
    in property <image> source: Art.scene;
    in property <float> src-w: 1600;
    in property <float> src-h: 900;
    // real screenshots are shown whole (contain); the fake 16:9 art fills the stage (cover)
    in property <bool> contain: false;
    in property <bool> interactive: false;
    // the box being drawn (image px)
    in property <bool> drafting: false;
    in property <ZoneData> draft;
    in property <[ZoneData]> zones;
    in property <bool> labels: true;
    in property <int> selected: -1;
    in property <length> radius: Radius.md;
    in property <bool> round-top: true;
    in property <bool> round-bottom: true;
    in property <color> behind: Palette.bg;
    // real screenshots (contain) follow the live view when there is one
    property <bool> live: root.contain && LiveView.on;
    property <float> pw: root.live ? LiveView.w : root.src-w;
    property <float> ph: root.live ? LiveView.h : root.src-h;
    out property <float> scale: root.contain ? min(root.width / 1px / root.pw, root.height / 1px / root.ph) : max(root.width / 1px / root.pw, root.height / 1px / root.ph);
    out property <length> off-x: (root.width - root.pw * root.scale * 1px) / 2;
    out property <length> off-y: (root.height - root.ph * root.scale * 1px) / 2;
    callback zone-clicked(int);
    // 0 press, 1 move, 2 release; x and y in image px; scale = view px per image px
    callback pointer(int, float, float, float);
    background: Palette.stage-bg;
    // The real window clips to these corners. Software renders cannot, so the CornerMask below paints them.
    border-top-left-radius: root.round-top ? root.radius : 0px;
    border-top-right-radius: root.round-top ? root.radius : 0px;
    border-bottom-left-radius: root.round-bottom ? root.radius : 0px;
    border-bottom-right-radius: root.round-bottom ? root.radius : 0px;
    clip: true;
    init => {
        if root.contain {
            LiveView.stage-size(root.width, root.height);
        }
    }
    changed width => {
        if root.contain {
            LiveView.stage-size(root.width, root.height);
        }
    }
    changed height => {
        if root.contain {
            LiveView.stage-size(root.width, root.height);
        }
    }
    Image {
        x: root.off-x;
        y: root.off-y;
        width: root.pw * root.scale * 1px;
        height: root.ph * root.scale * 1px;
        source: root.live ? LiveView.frame : root.source;
        image-fit: fill;
        // the game picture itself (the tests check that the live view note is never on it)
        accessible-role: image;
        accessible-label: "Game picture";
    }

    for z[i] in root.zones: ZoneOutline {
        // Zone kinds carry no color (Max, 2026-11-22). d-black: a light outline with a black keyline, so it holds
        // on bright games; the selected zone is white and 2 px; off zones are dimmed (45 %, keyline 30 %).
        property <color> zf: Palette.zone-fill;
        property <bool> sel: i == root.selected;
        line: self.sel ? Palette.on : Palette.text;
        x: root.off-x + z.x * root.scale * 1px;
        y: root.off-y + z.y * root.scale * 1px;
        width: z.w * root.scale * 1px;
        height: z.h * root.scale * 1px;
        selected: self.sel;
        dim: !z.on;
        line-w: self.sel ? 2px : 1.5px;
        background: z.on ? self.zf : self.zf.with-alpha(0.063);
        if self.sel: Rectangle {
            for p in [{ x: 0, y: 0 }, { x: 0.5, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 0.5 }, { x: 1, y: 0.5 }, { x: 0, y: 1 }, { x: 0.5, y: 1 }, { x: 1, y: 1 }]: Rectangle {
                x: parent.width * p.x - 4px;
                y: parent.height * p.y - 4px;
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: Palette.knob;
                border-width: 1.5px;
                border-color: Palette.on-ink;
            }
        }
        if !root.interactive: TouchArea {
            clicked => {
                root.zone-clicked(i);
            }
        }
    }
    // the box being drawn, with the same keyline
    if root.drafting: ZoneOutline {
        x: root.off-x + root.draft.x * root.scale * 1px;
        y: root.off-y + root.draft.y * root.scale * 1px;
        width: root.draft.w * root.scale * 1px;
        height: root.draft.h * root.scale * 1px;
        line: Palette.edit-draft-line;
        background: Palette.edit-draft-fill;
    }
    // A left drag draws, moves or resizes. The release of ANY button ends a TouchArea's mouse grab, and its
    // `moved` then stops while `pressed` stays true (Max, 2026-11-22: a right click froze the box, and the left
    // release put it at the cursor). So the drag is tracked here and moves come from `pointer-event`, which
    // fires with or without the grab. A right press cancels the drag (3), as does a lost pointer; other buttons
    // are ignored. Esc cancels in app.slint.
    if root.interactive: TouchArea {
        property <bool> dragging: false;
        mouse-cursor: crosshair;
        accessible-role: image;
        accessible-label: "Screenshot";
        function send(kind: int) {
            root.pointer(kind, (self.mouse-x - root.off-x) / 1px / root.scale, (self.mouse-y - root.off-y) / 1px / root.scale, root.scale);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                self.dragging = true;
                self.send(0);
            } else if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if self.dragging {
                    self.dragging = false;
                    self.send(2);
                }
            } else if e.kind == PointerEventKind.move {
                if self.dragging {
                    self.send(1);
                }
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) || e.kind == PointerEventKind.cancel {
                if self.dragging {
                    self.dragging = false;
                    self.send(3);
                }
            }
        }
        // the grab was lost (another button's release) and the mouse left the stage: the left release may
        // never come here, so the drag is cancelled
        changed has-hover => {
            if !self.has-hover && self.dragging {
                self.dragging = false;
                self.send(3);
            }
        }
    }
    // Tags go above every zone box, so they are drawn after all boxes.
    if root.labels: Rectangle {
        for z[i] in root.zones: Rectangle {
            property <color> zc: Palette.text-2;
            x: root.off-x + z.x * root.scale * 1px - 1.5px;
            y: root.off-y + z.y * root.scale * 1px - self.height - Space.s1;
            height: 20px;
            width: tag.preferred-width;
            border-radius: Radius.xs;
            background: self.zc;
            // an off zone is drawn at 45 %, tag text included (CSS .zone.off { opacity: 0.45 })
            opacity: z.on ? 1 : 0.45;
            tag := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: Space.s1;
                if z.kind == Kind.ignore: CIcon {
                    source: Icons.ban-sm;
                    size: Size.icon-sm;
                    color: Palette.on-tag;
                }
                Text {
                    text: Kinds.name(z.kind) + (z.on ? "" : " · off");
                    font-size: Type.fs1;
                    font-weight: Type.w-semibold;
                    color: Palette.on-tag;
                    vertical-alignment: center;
                }
            }
        }
    }
    if Render.software: CornerMask {
        width: 100%;
        height: 100%;
        radius: root.radius;
        color: root.behind;
        top: root.round-top;
        bottom: root.round-bottom;
    }
}

// "Live" (with a green dot), or why the saved screenshot shows (LiveView.note). It sits in the line under a stage,
// never on the game picture (Max, 2026-11-23: the chip covered the top right corner, where a zone may be).
// Empty note: nothing.
export component LiveNote inherits Rectangle {
    width: row.preferred-width;
    height: 22px;
    horizontal-stretch: 0;
    accessible-role: text;
    accessible-label: "Live view";
    accessible-value: LiveView.note;
    row := HorizontalLayout {
        spacing: 6px;
        if LiveView.note-live: VerticalLayout {
            alignment: center;
            Dot {
                size: 6px;
                tint: Palette.ok;
            }
        }
        Text {
            text: LiveView.note;
            font-size: Type.fs1;
            font-weight: LiveView.note-live ? Type.w-medium : Type.w-regular;
            color: LiveView.note-live ? Palette.ok : Palette.text-3;
            vertical-alignment: center;
        }
    }
}

// Zone list row (round 4): grey kind icon, name, toggle. With `editable`, the name of the selected row is a
// text field (rename).
export component ZoneRow inherits Rectangle {
    in property <ZoneData> zone;
    in property <bool> selected;
    in property <bool> first;
    in property <bool> editable: false;
    callback renamed(string);
    // true when Enter ended it (the window then takes the keys again)
    callback rename-done(bool);
    in property <length> pad-x: Space.s5;
    in property <length> row-h: Size.row;
    callback toggled(bool);
    callback clicked();
    height: root.row-h;
    background: root.selected ? Palette.surface-2 : transparent;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        spacing: Space.s3;
        CIcon {
            source: Kinds.icon(root.zone.kind);
            color: root.selected ? Palette.text : Palette.text-2;
        }

        if !(root.editable && root.selected): Text {
            text: root.zone.name;
            horizontal-stretch: 1;
            font-weight: Type.w-medium;
            overflow: elide;
            vertical-alignment: center;
            color: root.zone.on ? Palette.text : Palette.text-2;
        }
        if root.editable && root.selected: TextInput {
            text: root.zone.name;
            horizontal-stretch: 1;
            font-weight: Type.w-medium;
            vertical-alignment: center;
            single-line: true;
            color: root.zone.on ? Palette.text : Palette.text-2;
            selection-background-color: Palette.accent-soft;
            accessible-label: "Zone name";
            // the typed text waits in Rust; Enter or leaving the field saves it as one change (one undo step)
            edited => {
                root.renamed(self.text);
            }
            accepted => {
                root.rename-done(true);
            }
            changed has-focus => {
                if !self.has-focus {
                    root.rename-done(false);
                }
            }
            // follow the model when it changes from outside (undo), since typing breaks the text binding
            property <string> model-name: root.zone.name;
            changed model-name => {
                self.text = self.model-name;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                on: root.zone.on;
                label: root.zone.name;
                toggled(v) => {
                    root.toggled(v);
                }
            }
        }
    }
}

// Kind picker (.seg in .ztools): the grey kind line icons. The kind has no color (Max, 2026-11-22).
export component KindPicker inherits Rectangle {
    in property <Kind> kind: Kind.dialogue;
    callback picked(Kind);
    height: 32px;
    border-radius: Radius.md;
    background: Palette.surface-2;
    border-width: 1px;
    border-color: Palette.line-2;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for k in [Kind.dialogue, Kind.speaker, Kind.pickups, Kind.prompts, Kind.ignore]: Rectangle {
            border-radius: Radius.sm;
            background: k == root.kind ? Palette.surface-3 : transparent;
            accessible-role: tab;
            accessible-label: Kinds.name(k);
            accessible-item-selected: k == root.kind;
            accessible-action-default => {
                root.picked(k);
            }
            HorizontalLayout {
                padding-left: Space.s3;
                padding-right: Space.s3;
                spacing: Space.s2;
                CIcon {
                    source: Kinds.icon(k);
                    color: k == root.kind ? Palette.text : Palette.text-2;
                }

                Text {
                    text: Kinds.name(k);
                    font-weight: Type.w-medium;
                    vertical-alignment: center;
                    color: k == root.kind ? Palette.text : Palette.text-2;
                }
            }

            TouchArea {
                clicked => {
                    root.picked(k);
                }
            }
        }
    }
}

// Select / Draw zone, kind picker, Retake screenshot.
export component ZoneTools inherits HorizontalLayout {
    in-out property <bool> draw: true;
    in property <Kind> kind: Kind.dialogue;
    callback kind-picked(Kind);
    callback retake();
    spacing: Space.s3;
    alignment: stretch;
    Rectangle {
        height: 32px;
        horizontal-stretch: 0;
        border-radius: Radius.md;
        background: Palette.surface-2;
        border-width: 1px;
        border-color: Palette.line-2;
        HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for t[i] in [{ label: "Select", icon: Icons.pointer }, { label: "Draw zone", icon: Icons.plus }]: Rectangle {
                property <bool> on: (i == 1) == root.draw;
                border-radius: Radius.sm;
                background: self.on ? Palette.surface-3 : transparent;
                accessible-role: tab;
                accessible-label: t.label;
                accessible-item-selected: self.on;
                accessible-action-default => {
                    root.draw = i == 1;
                }
                HorizontalLayout {
                    padding-left: Space.s3;
                    padding-right: Space.s3;
                    spacing: Space.s2;
                    CIcon {
                        source: t.icon;
                        color: on ? Palette.text : Palette.text-2;
                    }

                    Text {
                        text: t.label;
                        font-weight: Type.w-medium;
                        vertical-alignment: center;
                        color: on ? Palette.text : Palette.text-2;
                    }
                }

                TouchArea {
                    clicked => {
                        root.draw = i == 1;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: Space.s2;
        horizontal-stretch: 0;
        Text {
            text: "Kind";
            font-size: Type.fs1;
            font-weight: Type.w-medium;
            color: Palette.text-3;
            vertical-alignment: center;
        }
    }

    KindPicker {
        horizontal-stretch: 0;
        kind: root.kind;
        picked(k) => {
            root.kind-picked(k);
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    Button {
        text: "Retake screenshot";
        icon: Icons.camera;
        clicked => {
            root.retake();
        }
    }
}
