// Window chrome: the title strip (no nav bar), the window controls, the setup footer and the setup heading.
import { Palette, Space, Radius, Size, Type, Motion, Icons } from "../theme.slint";
import { Icon, CIcon, Button, BtnKind, IconButton, StatusDot, Status } from "base.slint";

export { Status }

export global Chrome {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
}

component WinButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked();
    width: 46px;
    background: touch.has-hover ? (root.danger ? Palette.close-hover : Palette.surface-2) : transparent;
    animate background {
        duration: Motion.fast;
        easing: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        source: root.icon;
        width: 15px;
        height: 15px;
        color: touch.has-hover ? (root.danger ? #FFFFFF : Palette.text) : Palette.text-2;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component WinControls inherits HorizontalLayout {
    WinButton {
        icon: Icons.minus;
        label: "Minimize";
        clicked => {
            Chrome.minimize();
        }
    }

    WinButton {
        icon: Icons.square;
        label: "Maximize";
        clicked => {
            Chrome.maximize();
        }
    }

    WinButton {
        icon: Icons.x;
        label: "Close";
        danger: true;
        clicked => {
            Chrome.close();
        }
    }
}

// The app name with its logo: the strip lead in setup.
export component Brand inherits HorizontalLayout {
    spacing: Space.s2;
    padding-left: Space.s4;
    VerticalLayout {
        alignment: center;
        Image {
            source: Icons.logo;
            width: 20px;
            height: 20px;
        }
    }

    Text {
        text: "DialogReader";
        font-weight: Type.w-strong;
        color: Palette.text;
        vertical-alignment: center;
    }
}

// A pressable item of the strip lead (.gname, .back): 32 px, a surface-2 fill on hover, scale on press.
component LeadButton inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    y: (Size.strip - Size.ctl) / 2;
    height: Size.ctl;
    width: lay.preferred-width;
    border-radius: Radius.md;
    background: touch.has-hover ? Palette.surface-2 : transparent;
    transform-scale: touch.pressed ? Motion.press : 1;
    animate background, transform-scale {
        duration: Motion.fast;
        easing: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    lay := HorizontalLayout {
        @children
    }

    if root.tip != "" && root.enabled: Tooltip {
        Rectangle {
            border-radius: Radius.md;
            border-width: 1px;
            border-color: Palette.line-2;
            background: Palette.surface-2;
            HorizontalLayout {
                padding-left: Space.s2;
                padding-right: Space.s2;
                padding-top: Space.s1;
                padding-bottom: Space.s1;
                Text {
                    text: root.tip;
                    font-size: Type.fs-small;
                    color: Palette.text;
                    accessible-role: none;
                }
            }
        }
    }
}

// What the strip lead shows: the brand (setup), the game name (Overview) or back plus the page name (sub-pages).
export enum StripMode { setup, main, sub }

// One lead part. It fades out in 80 ms, and the next one fades in 160 ms after that (brief 3.1, sequential).
// While it is not shown it takes no clicks and is not in the accessibility tree.
component LeadPart inherits Rectangle {
    in property <bool> shown;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.shown ? Motion.swap-in : Motion.swap-out;
        delay: root.shown ? Motion.swap-out : 0ms;
        easing: root.shown ? cubic-bezier(0.2, 0.7, 0.2, 1) : cubic-bezier(0.4, 0, 1, 1);
    }
    @children
    if !root.shown: TouchArea { }
}

// The title strip (40 px, no line under it). Left: the brand, the game name (click or Ctrl K opens the switcher)
// or back plus the page name. Right: the status dot with its tip, the gear (Overview only) and the window
// controls. Empty space drags the window; a double click maximizes it.
export component TitleStrip inherits Rectangle {
    in property <StripMode> mode: StripMode.main;
    // the game name as shown (app.slint holds the old name while it rolls out)
    in property <string> game;
    // the game name rolls out (up 8 px and fades) while this is true, and back in after it
    in property <bool> rolling: false;
    // the sub-page name next to the back chevron ("Settings", "Zones", "Activity")
    in property <string> page-name;
    in property <Status> status: Status.reading;
    in property <string> status-tip: "Reading";
    in property <bool> show-gear: true;
    callback game-clicked();
    callback back();
    callback gear();
    height: Size.strip;
    background: Palette.bg;
    TouchArea {
        moved => {
            if self.pressed {
                Chrome.drag();
            }
        }
        double-clicked => {
            Chrome.maximize();
        }
    }

    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            LeadPart {
                shown: root.mode == StripMode.setup;
                Brand {
                    height: Size.strip;
                }
            }

            LeadPart {
                shown: root.mode == StripMode.main;
                LeadButton {
                    x: Space.s2;
                    label: "Switch game";
                    tip: "Switch game";
                    enabled: root.mode == StripMode.main;
                    clicked => {
                        root.game-clicked();
                    }
                    HorizontalLayout {
                        padding-left: Space.s2;
                        padding-right: Space.s2;
                        spacing: Space.s2;
                        Rectangle {
                            width: name.preferred-width;
                            name := Text {
                                y: root.rolling ? -8px : 0px;
                                height: parent.height;
                                text: root.game;
                                font-weight: Type.w-strong;
                                color: Palette.text;
                                vertical-alignment: center;
                                opacity: root.rolling ? 0 : 1;
                                animate opacity, y {
                                    duration: root.rolling ? Motion.switch-out : Motion.switch-in;
                                    easing: root.rolling ? cubic-bezier(0.4, 0, 1, 1) : cubic-bezier(0.16, 1, 0.3, 1);
                                }
                            }
                        }

                        CIcon {
                            source: Icons.chev-down-sm;
                            size: 14px;
                        }
                    }
                }
            }

            LeadPart {
                shown: root.mode == StripMode.sub;
                LeadButton {
                    x: Space.s2;
                    label: "Back";
                    tip: "Back (Esc)";
                    enabled: root.mode == StripMode.sub;
                    clicked => {
                        root.back();
                    }
                    HorizontalLayout {
                        padding-left: Space.s1;
                        padding-right: Space.s2;
                        spacing: Space.s1;
                        CIcon {
                            source: Icons.chev-left;
                        }

                        Text {
                            text: root.page-name;
                            font-weight: Type.w-strong;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.mode != StripMode.setup: StatusDot {
            status: root.status;
            tip: root.status-tip;
        }
        if root.mode == StripMode.main && root.show-gear: HorizontalLayout {
            padding-left: Space.s1;
            padding-right: Space.s1;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.settings;
                    tip: "Settings";
                    clicked => {
                        root.gear();
                    }
                }
            }
        }
        WinControls { }
    }
}

// Setup footer: Back on the left, the step dots in the middle, the main action (white pill) on the right, in the
// 960 px column. The active dot is 20 px wide (260 ms).
export component ObFoot inherits Rectangle {
    in property <string> primary: "Continue";
    in property <image> primary-icon: Icons.arrow-right;
    // 1 to 5
    in property <int> step: 1;
    // a problem with this step, said in plain words (no screenshot, could not save)
    in property <string> notice;
    callback back();
    callback next();
    height: 72px;
    HorizontalLayout {
        x: (parent.width - Size.col) / 2;
        width: Size.col;
        padding-top: 20px;
        padding-bottom: 20px;
        Button {
            text: "Back";
            icon: Icons.chev-left;
            kind: BtnKind.ghost;
            pad-x: Space.s1;
            clicked => {
                root.back();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            if root.notice != "": Text {
                x: Space.s4;
                width: parent.width - 2 * Space.s4;
                height: parent.height;
                text: root.notice;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                color: Palette.danger;
            }
        }

        Button {
            text: root.primary;
            trail: root.primary-icon;
            kind: BtnKind.primary;
            clicked => {
                root.next();
            }
        }
    }

    // the step dots, centred in the window
    if root.notice == "": HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: (parent.height - 8px) / 2;
        width: self.preferred-width;
        height: 8px;
        spacing: Space.s2;
        for i in 5: Rectangle {
            width: i + 1 == root.step ? 20px : 8px;
            height: 8px;
            border-radius: 4px;
            background: i + 1 == root.step ? Palette.text : Palette.text-off;
            animate width, background {
                duration: Motion.page;
                easing: cubic-bezier(0.16, 1, 0.3, 1);
            }
        }
    }
}

// Title and lead at the same spot on every setup step: 26 px title, 14 px grey lead.
export component ObHead inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    spacing: Space.s1;
    Text {
        text: root.title;
        height: Type.lh-title;
        font-size: Type.fs-title;
        font-weight: Type.w-title;
        letter-spacing: Type.ls-title;
        color: Palette.text;
        vertical-alignment: center;
    }

    if root.lead != "": Text {
        text: root.lead;
        height: Type.lh-body;
        color: Palette.text-2;
        vertical-alignment: center;
    }
}
