// Window chrome: title bars, onboarding steps and footer, main-window tabs and game button.
import { Palette, Space, Radius, Size, Type, Icons } from "../theme.slint";
import { Icon, CIcon, Kbd, Button, BtnKind, Thumb, StatusChip, VSep } from "base.slint";

export global Chrome {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
}

component WinButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked();
    width: 46px;
    background: touch.has-hover ? (root.danger ? Palette.win-close : Palette.surface-2) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        source: root.icon;
        color: touch.has-hover ? Palette.text : Palette.text-3;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component WinControls inherits HorizontalLayout {
    padding-left: Space.s2;
    WinButton {
        icon: Icons.minus;
        label: "Minimize";
        clicked => {
            Chrome.minimize();
        }
    }

    WinButton {
        icon: Icons.square;
        label: "Maximize";
        clicked => {
            Chrome.maximize();
        }
    }

    WinButton {
        icon: Icons.x;
        label: "Close";
        danger: true;
        clicked => {
            Chrome.close();
        }
    }
}

export component Brand inherits HorizontalLayout {
    spacing: Space.s2;
    padding-right: Space.s4;
    VerticalLayout {
        alignment: center;
        Image {
            source: Icons.logo;
            width: 24px;
            height: 24px;
        }
    }

    Text {
        text: "DialogReader";
        font-size: Type.fs2;
        font-weight: Type.w-semibold;
        color: Palette.text;
        vertical-alignment: center;
    }
}

// Title bar frame: 52 px, bottom line, drag area behind the content.
export component Bar inherits Rectangle {
    height: Size.bar;
    background: Palette.bg;
    TouchArea {
        moved => {
            if self.pressed {
                Chrome.drag();
            }
        }
        double-clicked => {
            Chrome.maximize();
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.line;
    }

    @children
}

component Step inherits HorizontalLayout {
    in property <int> n;
    in property <int> cur;
    in property <string> label;
    spacing: Space.s2;
    VerticalLayout {
        alignment: center;
        Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.n < root.cur ? Palette.surface-3 : root.n == root.cur ? Palette.accent : Palette.line-2;
        background: root.n < root.cur ? Palette.surface-3 : root.n == root.cur ? Palette.accent : transparent;
        if root.n < root.cur: Icon {
            source: Icons.check-sm;
            width: Size.icon-sm;
            height: Size.icon-sm;
            color: Palette.text;
        }
        if root.n >= root.cur: Text {
            text: root.n;
            font-size: Type.fs1;
            font-weight: Type.w-medium;
            color: root.n == root.cur ? Palette.on-accent : Palette.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    }

    Text {
        text: root.label;
        font-weight: Type.w-medium;
        font-size: Type.fs2;
        vertical-alignment: center;
        color: root.n < root.cur ? Palette.text-2 : root.n == root.cur ? Palette.text : Palette.text-3;
    }
}

component StepSep inherits Rectangle {
    width: 24px;
    height: 1px;
    background: Palette.line-2;
}

// Onboarding title bar. step 0 = welcome (brand only), 1..5 = setup steps.
export component ObBar inherits Bar {
    in property <int> step: 0;
    HorizontalLayout {
        padding-left: Space.s4;
        Brand { }

        Rectangle {
            horizontal-stretch: 1;
        }

        WinControls { }
    }

    if root.step > 0: HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: Space.s3;
        Step {
            n: 1;
            cur: root.step;
            label: "Game";
        }

        VerticalLayout {
            alignment: center;
            StepSep { }
        }

        Step {
            n: 2;
            cur: root.step;
            label: "Zones";
        }

        VerticalLayout {
            alignment: center;
            StepSep { }
        }

        Step {
            n: 3;
            cur: root.step;
            label: "Keys";
        }

        VerticalLayout {
            alignment: center;
            StepSep { }
        }

        Step {
            n: 4;
            cur: root.step;
            label: "Voice";
        }

        VerticalLayout {
            alignment: center;
            StepSep { }
        }

        Step {
            n: 5;
            cur: root.step;
            label: "Mode";
        }
    }
}

// Onboarding footer: Back on the left, the main action on the right, in the 960 px column.
export component ObFoot inherits Rectangle {
    in property <string> primary: "Continue";
    in property <image> primary-icon: Icons.arrow-right;
    // a problem with this step, said in plain words (no screenshot, could not save)
    in property <string> notice;
    callback back();
    callback next();
    height: 72px;
    Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }

    HorizontalLayout {
        x: (parent.width - Size.col) / 2;
        width: Size.col;
        alignment: space-between;
        padding-top: 16px;
        padding-bottom: 16px;
        Button {
            text: "Back";
            icon: Icons.arrow-left;
            large: true;
            clicked => {
                root.back();
            }
        }

        if root.notice != "": Text {
            text: root.notice;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.danger;
        }

        Button {
            text: root.primary;
            trail: root.primary-icon;
            kind: BtnKind.primary;
            large: true;
            clicked => {
                root.next();
            }
        }
    }
}

// Title and lead at the same spot on every onboarding step.
export component ObHead inherits VerticalLayout {
    in property <string> title;
    in property <string> lead;
    spacing: Space.s2;
    Text {
        text: root.title;
        height: 37px;
        font-size: Type.fs5;
        font-weight: Type.w-semibold;
        letter-spacing: Type.ls-display;
        color: Palette.text;
        vertical-alignment: center;
    }

    if root.lead != "": Text {
        text: root.lead;
        height: 23px;
        font-size: Type.fs3;
        color: Palette.text-2;
        vertical-alignment: center;
    }
}

// The game button in the main title bar (.switcher).
export component GameButton inherits Rectangle {
    in property <string> name: "Red Dead Redemption 2";
    in property <string> art: "rdr2";
    in property <image> cover;
    callback clicked();
    height: Size.ctl;
    border-radius: Radius.md;
    border-width: 1px;
    border-color: Palette.line-2;
    background: touch.has-hover ? Palette.surface-2 : Palette.surface;
    accessible-role: button;
    accessible-label: "Switch game";
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: Space.s2;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Thumb {
                width: 24px;
                height: 24px;
                art: root.art;
                picture: root.cover;
                radius: Radius.xs;
                behind: Palette.surface;
            }
        }

        Text {
            text: root.name;
            font-weight: Type.w-medium;
            color: Palette.text;
            vertical-alignment: center;
        }

        CIcon {
            source: Icons.chev-down;
        }

        VerticalLayout {
            alignment: center;
            Kbd {
                text: "Ctrl K";
                small: true;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Tab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> on;
    callback clicked();
    horizontal-stretch: 0;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.on;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: Space.s3;
        padding-right: Space.s3;
        spacing: Space.s2;
        CIcon {
            source: root.icon;
            color: root.on ? Palette.text : Palette.text-3;
        }

        Text {
            text: root.text;
            font-weight: Type.w-medium;
            color: root.on || touch.has-hover ? Palette.text : Palette.text-2;
            vertical-alignment: center;
        }
    }

    if root.on: Rectangle {
        x: Space.s3;
        width: parent.width - 2 * Space.s3;
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: Palette.accent;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Main window title bar: brand, game button, tabs, status, window controls.
export component MainBar inherits Bar {
    in property <int> tab: 0;
    in property <string> game: "Red Dead Redemption 2";
    in property <string> art: "rdr2";
    in property <image> cover;
    in property <string> status: "Reading";
    in property <bool> status-ok: true;
    callback tab-clicked(int);
    callback game-clicked();
    HorizontalLayout {
        padding-left: Space.s4;
        Brand { }

        VerticalLayout {
            alignment: center;
            GameButton {
                name: root.game;
                art: root.art;
                cover: root.cover;
                clicked => {
                    root.game-clicked();
                }
            }
        }

        HorizontalLayout {
            padding-left: Space.s4;
            padding-right: Space.s4;
            VerticalLayout {
                alignment: center;
                VSep { }
            }
        }

        Tab {
            text: "Overview";
            icon: Icons.grid;
            on: root.tab == 0;
            clicked => {
                root.tab-clicked(0);
            }
        }

        Tab {
            text: "Zones";
            icon: Icons.zone;
            on: root.tab == 1;
            clicked => {
                root.tab-clicked(1);
            }
        }

        Tab {
            text: "Settings";
            icon: Icons.settings;
            on: root.tab == 2;
            clicked => {
                root.tab-clicked(2);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            StatusChip {
                text: root.status;
                ok: root.status-ok;
            }
        }

        Rectangle {
            width: Space.s3;
        }

        WinControls { }
    }
}
